{
  "name": "tikareta-home",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf:preview": "pnpm build && wrangler dev",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt",
    "type-check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:vrt": "playwright test --config playwright.vrt.config.ts",
    "test:vrt:update": "playwright test --config playwright.vrt.config.ts --update-snapshots",
    "og": "node scripts/generate-og.mjs",
    "fonts": "node scripts/subset-fonts.mjs"
  },
  "dependencies": {
    "@lucide/astro": "1.33.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.0.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "lefthook": "2.1.12",
    "oxfmt": "0.55.0",
    "oxlint": "1.70.0",
    "subset-font": "2.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.103.0"
  },
  "packageManager": "pnpm@11.22.0"
}
