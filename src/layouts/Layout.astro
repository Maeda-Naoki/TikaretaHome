---
import '@styles/global.css';
import Footer from '@components/common/Footer.astro';
import Header from '@components/common/Header.astro';
import SEO from '@components/common/SEO.astro';
import SkipToContent from '@components/common/SkipToContent.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  datePublished?: string;
  dateModified?: string;
  jsonLd?: unknown;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType,
  noindex = false,
  keywords,
  datePublished,
  dateModified,
  jsonLd,
} = Astro.props;
const locale = Astro.currentLocale ?? 'ja';
const lang = locale === 'en' ? 'en' : 'ja';

// 太字ウェイト(900)はトップページのヒーロー/数値背景でしか使わないため、
// 先読みはトップ(/ , /en/)に限定する。他ページで先読みすると未使用の76KBを
// 余計に取得し「preloaded but not used」警告になる。
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const isHome = pathname === '' || pathname === '/en';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      noindex={noindex}
      keywords={keywords}
      datePublished={datePublished}
      dateModified={dateModified}
      jsonLd={jsonLd}
    />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* セルフホストのサブセットフォント。@font-faceはglobal.cssで定義。
       本文(400)は全ページ、ヒーロー見出し(900)はトップのLCP向けのみ先読み。 */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/zen-kaku-gothic-new-400.woff2"
      crossorigin
    />
    {
      isHome && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href="/fonts/zen-kaku-gothic-new-900.woff2"
          crossorigin
        />
      )
    }
  </head>
  <body style="background:var(--bg);color:var(--ink);" class="min-h-screen flex flex-col">
    <SkipToContent />
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // WCAG 2.3.3: prefers-reduced-motion を尊重したスクロールアニメーション
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const animatedSelectors = '.fade-in-up, .slide-in-left, .slide-in-right, .scale-in';
      const revealSelector = '.reveal';

      if (prefersReducedMotion) {
        document.querySelectorAll(animatedSelectors).forEach((el) => el.classList.add('is-visible'));
        document.querySelectorAll(revealSelector).forEach((el) => el.classList.add('in'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
              }
            });
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll(animatedSelectors).forEach((el) => observer.observe(el));

        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll(revealSelector).forEach((el) => revealObserver.observe(el));
      }
    </script>
  </body>
</html>
