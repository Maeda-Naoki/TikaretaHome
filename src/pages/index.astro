---
import About from '@components/home/About.astro';
import FAQ from '@components/home/FAQ.astro';
import FeatureHighlights from '@components/home/FeatureHighlights.astro';
import FinalCTA from '@components/home/FinalCTA.astro';
import Hero from '@components/home/Hero.astro';
import HowItWorks from '@components/home/HowItWorks.astro';
import PricingSummary from '@components/home/PricingSummary.astro';
import Showcase from '@components/home/Showcase.astro';
import TypeDiagnosis from '@components/home/TypeDiagnosis.astro';
import ValueProposition from '@components/home/ValueProposition.astro';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { faqByCategory } from '@data/faq';
import Layout from '@layouts/Layout.astro';
import { useTranslations } from '@utils/i18n';
import {
  type Locale,
  createFAQPageLD,
  createOrganizationLD,
  createSoftwareApplicationLD,
  createWebSiteLD,
} from '@utils/seo';
import { mapFAQItems } from '@utils/translationTypes';

const t = useTranslations(Astro.currentLocale);
const locale: Locale = Astro.currentLocale === 'en' ? 'en' : 'ja';

const homeFAQItems = mapFAQItems(t, faqByCategory.basic.slice(0, 3));

const jsonLd = [
  createWebSiteLD({ name: t.site.name, description: t.pages.home.description }),
  createSoftwareApplicationLD({
    locale,
    name: t.site.name,
    description: t.pages.home.description,
    pricingUrl: getAbsoluteLocaleUrl(locale, '/pricing'),
  }),
  createOrganizationLD({ name: t.site.name, description: t.site.description }),
  createFAQPageLD(homeFAQItems, locale),
];

const keywords = [
  '犬',
  '散歩',
  'おさんぽ',
  'おさんぽタイプ',
  '愛犬',
  '散歩記録',
  '散歩アプリ',
  '犬種',
  'タイプ診断',
  'Tikareta',
];
---

<Layout
  title={t.pages.home.title}
  description={t.pages.home.description}
  keywords={keywords}
  jsonLd={jsonLd}
>
  <Hero />
  <About />
  <ValueProposition />
  <HowItWorks />
  <TypeDiagnosis />
  <Showcase />
  <FeatureHighlights />
  <PricingSummary />
  <FAQ />
  <FinalCTA />
</Layout>
