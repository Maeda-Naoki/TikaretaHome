---
import Breadcrumbs from '@components/common/Breadcrumbs.astro';
import CTAButton from '@components/common/CTAButton.astro';
import FeatureCard from '@components/features/FeatureCard.astro';
import { freeFeatures, premiumFeatures } from '@data/features';
import Layout from '@layouts/Layout.astro';
import { useTranslations } from '@utils/i18n';
import {
  createBreadcrumbListLD,
  createItemListLD,
  createWebPageLD,
  getPageUrl,
} from '@utils/seo';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'ja';
const pageUrl = getPageUrl(locale, '/features');

const breadcrumbJsonLd = createBreadcrumbListLD([
  { name: t.nav.home, url: getPageUrl(locale, '/') },
  { name: t.nav.features, url: pageUrl },
]);

const webPageJsonLd = createWebPageLD({
  locale,
  name: t.pages.features.title,
  description: t.pages.features.description,
  url: pageUrl,
});

const featureListJsonLd = createItemListLD({
  name: t.pages.features.title,
  items: [...freeFeatures, ...premiumFeatures].map((feature) => {
    const featureKey = feature.titleKey.split('.')[1] as keyof typeof t.features;
    return {
      name: t.features[featureKey].title,
      description: t.features[featureKey].description,
    };
  }),
});

const jsonLd = [webPageJsonLd, breadcrumbJsonLd, featureListJsonLd];
---

<Layout
  title={t.pages.features.title}
  description={t.pages.features.description}
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={[{ name: t.nav.features, url: '/features' }]} />

    <div class="mb-12">
      <h1 class="text-4xl font-display font-bold text-warm-gray-900 mb-3 hero-slide-in-left">
        {t.nav.features}
      </h1>
      <div class="w-14 h-1 bg-primary-400 rounded-full mb-4 hero-slide-in-left"></div>
      <p class="text-lg text-warm-gray-600 max-w-2xl hero-slide-in-left">
        {t.pages.features.description}
      </p>
    </div>

    <!-- 無料機能 -->
    <section class="mb-16">
      <h2 class="text-2xl font-display font-bold text-warm-gray-900 mb-2 fade-in-up">
        無料で使える機能
      </h2>
      <div class="w-10 h-1 bg-secondary-400 rounded-full mb-8 fade-in-up"></div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {freeFeatures.map((feature) => {
          const featureKey = feature.titleKey.split('.')[1] as keyof typeof t.features;
          return (
            <FeatureCard
              icon={feature.icon}
              iconType={feature.iconType}
              title={t.features[featureKey].title}
              description={t.features[featureKey].description}
            />
          );
        })}
      </div>
    </section>

    <!-- プレミアム機能 -->
    <section class="mb-16">
      <h2 class="text-2xl font-display font-bold text-warm-gray-900 mb-2 fade-in-up">
        プレミアム機能
      </h2>
      <div class="w-10 h-1 bg-primary-400 rounded-full mb-8 fade-in-up"></div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {premiumFeatures.map((feature) => {
          const featureKey = feature.titleKey.split('.')[1] as keyof typeof t.features;
          return (
            <FeatureCard
              icon={feature.icon}
              iconType={feature.iconType}
              title={t.features[featureKey].title}
              description={t.features[featureKey].description}
            />
          );
        })}
      </div>
    </section>

    <!-- CTA -->
    <div class="relative py-12 px-8 bg-cream-50 rounded-card border border-warm-gray-100 overflow-hidden fade-in-up">
      <div class="absolute top-[-20px] right-[-30px] w-[120px] h-[120px] bg-primary-100/40 blob-shape" aria-hidden="true"></div>
      <div class="relative z-10 text-center">
        <h2 class="text-2xl font-bold text-warm-gray-900 mb-4">
          今すぐ無料で始めよう
        </h2>
        <CTAButton text={t.nav.startFree} size="lg" />
      </div>
    </div>
  </div>
</Layout>
