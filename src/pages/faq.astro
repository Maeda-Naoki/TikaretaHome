---
import Breadcrumbs from '@components/common/Breadcrumbs.astro';
import FAQItem from '@components/faq/FAQItem.astro';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { faqByCategory } from '@data/faq';
import Layout from '@layouts/Layout.astro';
import { useTranslations } from '@utils/i18n';
import {
  type Locale,
  createBreadcrumbListLD,
  createFAQPageLD,
  createWebPageLD,
} from '@utils/seo';
import { resolveFAQItem } from '@utils/translationTypes';

const t = useTranslations(Astro.currentLocale);
const locale: Locale = Astro.currentLocale === 'en' ? 'en' : 'ja';
const pageUrl = getAbsoluteLocaleUrl(locale, '/faq');

const resolvedByCategory = Object.entries(faqByCategory).map(([category, items]) => ({
  category: category as keyof typeof faqByCategory,
  items: items.map((item) => resolveFAQItem(t, item)),
}));

const faqJsonLd = createFAQPageLD(
  resolvedByCategory.flatMap((c) => c.items.map(({ question, answer }) => ({ question, answer }))),
  locale
);

const breadcrumbJsonLd = createBreadcrumbListLD([
  { name: t.nav.home, url: getAbsoluteLocaleUrl(locale, '/') },
  { name: t.nav.faq, url: pageUrl },
]);

const webPageJsonLd = createWebPageLD({
  locale,
  name: t.pages.faq.title,
  description: t.pages.faq.description,
  url: pageUrl,
});
---

<Layout
  title={t.pages.faq.title}
  description={t.pages.faq.description}
  jsonLd={[webPageJsonLd, faqJsonLd, breadcrumbJsonLd]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={[{ name: t.nav.faq, url: '/faq' }]} />

    <div class="mb-12">
      <h1 class="text-4xl font-display font-bold text-warm-gray-900 mb-3 hero-slide-in-left">
        {t.faq.title}
      </h1>
      <div class="w-14 h-1 bg-primary-400 rounded-full hero-slide-in-left"></div>
    </div>

    {resolvedByCategory.map(({ category, items }) => (
      <section class="mb-12">
        <h2 class="text-xl font-bold text-warm-gray-900 mb-2 fade-in-up">
          {t.faq.categories[category]}
        </h2>
        <div class="w-8 h-0.5 bg-secondary-400 rounded-full mb-5 fade-in-up"></div>
        <div class="space-y-3">
          {items.map((item) => (
            <FAQItem id={item.id} question={item.question} answer={item.answer} />
          ))}
        </div>
      </section>
    ))}
  </div>
</Layout>
