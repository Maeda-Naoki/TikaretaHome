---
import Breadcrumbs from '@components/common/Breadcrumbs.astro';
import PlanComparisonTable from '@components/pricing/PlanComparisonTable.astro';
import PricingCard from '@components/pricing/PricingCard.astro';
import { plans } from '@data/pricing';
import Layout from '@layouts/Layout.astro';
import { useTranslations } from '@utils/i18n';
import { createBreadcrumbListLD } from '@utils/seo';

const t = useTranslations(Astro.currentLocale);

const jsonLd = createBreadcrumbListLD([
  { name: t.nav.home, url: 'https://tikareta.com/' },
  { name: t.nav.pricing, url: 'https://tikareta.com/pricing' },
]);
---

<Layout
  title={t.pages.pricing.title}
  description={t.pages.pricing.description}
  jsonLd={jsonLd}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={[{ name: t.nav.pricing, url: '/pricing' }]} />

    <div class="mb-12">
      <h1 class="text-4xl font-display font-bold text-warm-gray-900 mb-3 hero-slide-in-left">
        {t.nav.pricing}
      </h1>
      <div class="w-14 h-1 bg-primary-400 rounded-full mb-4 hero-slide-in-left"></div>
      <p class="text-lg text-warm-gray-600 max-w-2xl hero-slide-in-left">
        {t.pages.pricing.description}
      </p>
    </div>

    <!-- Billing Toggle -->
    <div class="billing-toggle" role="tablist" aria-label="billing">
      <button class="toggle-btn active" type="button" data-billing-toggle="monthly" aria-pressed="true">
        {t.pricingSummary.billingMonthly}
      </button>
      <button class="toggle-btn" type="button" data-billing-toggle="yearly" aria-pressed="false">
        {t.pricingSummary.billingYearly}
        <span class="save-tag">{t.pricingSummary.savingsTag}</span>
      </button>
    </div>

    <!-- Pricing Cards -->
    <div class="pricing-cards-wrapper" data-billing="monthly">
      <div class="grid md:grid-cols-3 gap-5 mb-16 items-start">
        {plans.map((plan) => (
          <PricingCard
            planKey={plan.key}
            name={t.pricing.plans[plan.key].name}
            monthly={plan.monthly}
            yearly={plan.yearly}
            features={Object.values(t.pricing.plans[plan.key].features)}
            cta={t.pricing.plans[plan.key].cta}
            recommended={plan.featured}
          />
        ))}
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="mb-16">
      <PlanComparisonTable />
    </div>

    <!-- FAQ Section -->
    <section class="bg-cream-50 rounded-card border border-warm-gray-100 p-8 fade-in-up">
      <h2 class="text-2xl font-bold text-warm-gray-900 mb-2">
        よくある質問
      </h2>
      <div class="w-10 h-1 bg-primary-400 rounded-full mb-6"></div>
      <div class="space-y-3">
        <details class="group bg-white rounded-card border border-warm-gray-100 transition-all hover:shadow-soft">
          <summary class="cursor-pointer p-5 font-bold text-warm-gray-900 list-none flex items-center justify-between gap-4">
            <span>{t.faq.pricing.freeFeatures.question}</span>
            <svg
              class="w-5 h-5 text-warm-gray-400 transform transition-transform group-open:rotate-180 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-warm-gray-600 border-t border-warm-gray-100 pt-4 mx-5">
            <p>{t.faq.pricing.freeFeatures.answer}</p>
          </div>
        </details>
        <details class="group bg-white rounded-card border border-warm-gray-100 transition-all hover:shadow-soft">
          <summary class="cursor-pointer p-5 font-bold text-warm-gray-900 list-none flex items-center justify-between gap-4">
            <span>{t.faq.pricing.cancelAnytime.question}</span>
            <svg
              class="w-5 h-5 text-warm-gray-400 transform transition-transform group-open:rotate-180 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-warm-gray-600 border-t border-warm-gray-100 pt-4 mx-5">
            <p>{t.faq.pricing.cancelAnytime.answer}</p>
          </div>
        </details>
        <details class="group bg-white rounded-card border border-warm-gray-100 transition-all hover:shadow-soft">
          <summary class="cursor-pointer p-5 font-bold text-warm-gray-900 list-none flex items-center justify-between gap-4">
            <span>{t.faq.pricing.paymentMethods.question}</span>
            <svg
              class="w-5 h-5 text-warm-gray-400 transform transition-transform group-open:rotate-180 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-warm-gray-600 border-t border-warm-gray-100 pt-4 mx-5">
            <p>{t.faq.pricing.paymentMethods.answer}</p>
          </div>
        </details>
      </div>
    </section>
  </div>
</Layout>

<style>
  .billing-toggle {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    border: 1px solid var(--line);
    background: transparent;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .toggle-btn.active {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .save-tag {
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    background: var(--s100);
    color: var(--s700);
    font-size: 0.73rem;
    font-weight: 600;
  }
  .toggle-btn.active .save-tag {
    background: var(--s500);
    color: #fff;
  }
</style>

<script>
  const wrappers = document.querySelectorAll<HTMLElement>('.pricing-cards-wrapper');
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('[data-billing-toggle]');

  function switchBilling(period: 'monthly' | 'yearly') {
    for (const btn of toggleBtns) {
      const isActive = btn.dataset.billingToggle === period;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    }
    for (const wrapper of wrappers) {
      wrapper.dataset.billing = period;
    }
  }

  for (const btn of toggleBtns) {
    btn.addEventListener('click', () => {
      const period = btn.dataset.billingToggle as 'monthly' | 'yearly';
      switchBilling(period);
    });
  }
</script>
