---
import Breadcrumbs from '@components/common/Breadcrumbs.astro';
import Layout from '@layouts/Layout.astro';
import { useTranslations } from '@utils/i18n';
import { createBreadcrumbListLD } from '@utils/seo';

const t = useTranslations(Astro.currentLocale);

const jsonLd = createBreadcrumbListLD([
  { name: t.nav.home, url: 'https://tikareta.com/en/' },
  { name: t.footer.privacy, url: 'https://tikareta.com/en/privacy' },
]);
---

<Layout
  title={t.pages.privacy.title}
  description={t.pages.privacy.description}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={[{ name: t.footer.privacy, url: '/en/privacy' }]} />

    <div class="mb-10">
      <h1 class="text-4xl font-display font-bold text-warm-gray-900 mb-3 slide-in-left">
        {t.footer.privacy}
      </h1>
      <div class="w-14 h-1 bg-primary-400 rounded-full slide-in-left"></div>
    </div>

    <div class="bg-white rounded-card border border-warm-gray-100 divide-y divide-warm-gray-100 fade-in-up">
      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">1</span>
          Handling of Personal Information
        </h2>
        <p class="text-warm-gray-700 pl-10">
          Osanpo Type ("the Service") properly manages user personal information and handles it in compliance with privacy protection laws.
        </p>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">2</span>
          Information We Collect
        </h2>
        <ul class="list-disc list-inside text-warm-gray-700 space-y-1.5 pl-10">
          <li>Email address</li>
          <li>Pet profile information (breed, age, name, etc.)</li>
          <li>Walk records (GPS location, time, distance, etc.)</li>
          <li>Rest spot information (location, photos, notes, etc.)</li>
          <li>Usage data</li>
        </ul>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">3</span>
          Purpose of Use
        </h2>
        <ul class="list-disc list-inside text-warm-gray-700 space-y-1.5 pl-10">
          <li>Providing and operating the Service</li>
          <li>Conducting Walking Type diagnosis</li>
          <li>Creating and analyzing statistical data</li>
          <li>Improving the Service and developing new features</li>
          <li>Responding to inquiries</li>
        </ul>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">4</span>
          Third-Party Disclosure
        </h2>
        <p class="text-warm-gray-700 pl-10">
          The Service will not provide personal information to third parties without user consent, except as required by law.
        </p>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">5</span>
          Location Data Handling
        </h2>
        <p class="text-warm-gray-700 pl-10">
          GPS location data is used only for creating walk records and will not be disclosed to other users unless explicitly shared.
        </p>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">6</span>
          Data Retention Period
        </h2>
        <p class="text-warm-gray-700 pl-10">
          Even after account deletion, data may be retained for periods required by law.
        </p>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">7</span>
          Contact
        </h2>
        <p class="text-warm-gray-700 pl-10">
          For inquiries regarding this Privacy Policy, please contact us through the inquiry form within the Service.
        </p>
      </div>
    </div>

    <p class="text-sm text-warm-gray-500 mt-6 fade-in-up">
      Last updated: February 15, 2026
    </p>
  </div>
</Layout>
