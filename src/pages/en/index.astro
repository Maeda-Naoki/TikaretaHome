---
import FeatureHighlights from '@components/home/FeatureHighlights.astro';
import FinalCTA from '@components/home/FinalCTA.astro';
import Hero from '@components/home/Hero.astro';
import HowItWorks from '@components/home/HowItWorks.astro';
import PricingSummary from '@components/home/PricingSummary.astro';
import TypeDiagnosis from '@components/home/TypeDiagnosis.astro';
import ValueProposition from '@components/home/ValueProposition.astro';
import { faqByCategory } from '@data/faq';
import Layout from '@layouts/Layout.astro';
import { useTranslations } from '@utils/i18n';
import {
  createFAQPageLD,
  createOrganizationLD,
  createSoftwareApplicationLD,
  createWebSiteLD,
} from '@utils/seo';
import { type FAQCategory, getFAQItemData } from '@utils/translationTypes';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'en';

const homeFAQItems = faqByCategory.basic.slice(0, 3).map((item) => {
  const categoryKey = item.category as FAQCategory;
  const parts = item.questionKey.split('.');
  const itemKey = parts[parts.length - 2];
  const itemData = getFAQItemData(t, categoryKey, itemKey);
  return {
    question: itemData?.question ?? '',
    answer: itemData?.answer ?? '',
  };
});

const jsonLd = [
  createWebSiteLD({
    name: t.site.name,
    description: t.pages.home.description,
  }),
  createSoftwareApplicationLD({
    locale,
    name: t.site.name,
    description: t.pages.home.description,
  }),
  createOrganizationLD({
    name: t.site.name,
    description: t.site.description,
  }),
  createFAQPageLD(homeFAQItems, locale),
];

const keywords = [
  'dog',
  'walking',
  'dog walking',
  'walk tracker',
  'walking type',
  'dog app',
  'pet tracker',
  'Tikareta',
];
---

<Layout
  title={t.pages.home.title}
  description={t.pages.home.description}
  keywords={keywords}
  jsonLd={jsonLd}
>
  <Hero />
  <ValueProposition />
  <HowItWorks />
  <TypeDiagnosis />
  <FeatureHighlights />
  <PricingSummary />
  <FinalCTA />
</Layout>
