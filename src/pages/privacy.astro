---
import Breadcrumbs from '@components/common/Breadcrumbs.astro';
import Layout from '@layouts/Layout.astro';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { useTranslations } from '@utils/i18n';
import {
  PRIVACY_LAST_MODIFIED,
  type Locale,
  createBreadcrumbListLD,
  createWebPageLD,
} from '@utils/seo';

const t = useTranslations(Astro.currentLocale);
const locale: Locale = Astro.currentLocale === 'en' ? 'en' : 'ja';
const pageUrl = getAbsoluteLocaleUrl(locale, '/privacy');

const CONTACT_EMAIL = 'support@tikareta.luckyretriever.app';

const breadcrumbJsonLd = createBreadcrumbListLD([
  { name: t.nav.home, url: getAbsoluteLocaleUrl(locale, '/') },
  { name: t.footer.privacy, url: pageUrl },
]);

const webPageJsonLd = createWebPageLD({
  locale,
  name: t.pages.privacy.title,
  description: t.pages.privacy.description,
  url: pageUrl,
  dateModified: PRIVACY_LAST_MODIFIED,
});

const jsonLd = [webPageJsonLd, breadcrumbJsonLd];

// 収集する個人情報のカテゴリ
const dataCategories = [
  {
    name: 'アカウント情報',
    items: 'メールアドレス、ニックネーム、プロフィール画像（認証プロバイダーから取得）',
    purpose: 'ユーザー認証およびサービス内での表示に利用します。メールアドレスは非公開です。',
  },
  {
    name: '位置情報',
    items: 'GPS座標（散歩ルート、休憩スポットの位置）',
    purpose:
      '散歩の記録・分析およびおさんぽタイプ診断に利用します。位置情報はお客様のみが閲覧でき、他のユーザーには公開されません。コミュニティに共有される場合でも、位置情報は除外されます。',
  },
  {
    name: '自宅位置情報',
    items: '登録されたホーム地点の座標（概略位置として100〜200m精度で保存）',
    purpose:
      'ルート提案機能（有料プラン）に利用します。自宅位置はお客様のみが閲覧できます。',
  },
  {
    name: '写真',
    items: '休憩スポットで撮影・選択された写真（1スポットあたり最大3枚、1枚あたり最大5MB）',
    purpose:
      'スポットの記録およびコミュニティでの共有（お客様がオプトインした場合のみ）に利用します。写真はCloudflare R2に保存されます。アップロードされた写真に含まれるGPS情報（Exifデータ）は、プライバシー保護のため自動的に除去されます。',
  },
  {
    name: '犬の情報',
    items: '犬の名前、犬種、年齢、体重',
    purpose:
      '散歩パターンの分析およびタイプ診断に利用します。健康に関する情報は、お客様のみが閲覧でき、コミュニティには犬種のみが表示されます。',
  },
  {
    name: '決済情報',
    items:
      'Stripe顧客ID（クレジットカード情報はStripe社が直接管理し、当社のサーバーには保存されません）',
    purpose: 'Standardプラン以上の決済処理に利用します。',
  },
  {
    name: '利用データ',
    items: '散歩記録、休憩理由タグ、リアクション、連続記録日数',
    purpose:
      '散歩記録の保存・表示、休憩パターンの統計分析、おさんぽタイプ診断の算出、コミュニティでの共有内容の表示、連続記録日数の計算、およびサービスの改善に利用します。',
  },
  {
    name: '端末情報',
    items: 'IPアドレス、ブラウザの種類・バージョン、OS情報、画面解像度',
    purpose:
      'セキュリティ対策（不正アクセスの検知）、サービスの改善、およびアクセス解析に利用します。',
  },
];

// 利用目的
const purposeItems = [
  '本サービスの提供・運営・維持',
  '散歩パターンの分析およびおさんぽタイプ診断',
  'コミュニティ機能の提供',
  '有料プランの決済処理',
  'お客様からのお問い合わせへの対応',
  '不具合の修正、機能改善のためのアクセスログ・エラーログ解析、新機能開発時のユーザー動線分析',
  '利用規約に違反する行為への対応',
  'セキュリティの確保（不正アクセスの検知・防止）',
];

// Google OAuth で取得するスコープ（Supabase Auth の Google プロバイダ既定スコープ。
// アプリ側で追加スコープは指定しておらず、非機微スコープのみ）
const googleScopes = [
  {
    scope: 'openid',
    detail:
      'お客様を一意に識別するためのGoogleアカウントID（OpenID Connect）。アカウントの作成・認証に使用します。',
  },
  {
    scope: 'https://www.googleapis.com/auth/userinfo.email（email）',
    detail:
      'メールアドレスおよびメール確認状態。アカウントの作成・本人確認・重複登録の防止に使用します。メールアドレスは非公開です。',
  },
  {
    scope: 'https://www.googleapis.com/auth/userinfo.profile（profile）',
    detail:
      '氏名（表示名）およびプロフィール画像のURL。サービス内でのお客様の表示（ニックネーム初期値・アイコン）に使用します。',
  },
];

// 第三者サービスの利用
const thirdPartyServices = [
  {
    name: 'Supabase',
    purpose: 'ユーザー認証、データベース、ファイルストレージ',
    data: 'アカウント情報、散歩データ、写真メタデータ',
    country: 'アメリカ合衆国',
    measures: 'SOC2 Type II認証取得、データ暗号化（保存時・通信時）',
  },
  {
    name: 'Cloudflare',
    purpose: 'ウェブサイトのホスティング、CDN、写真の保存（R2）、キャッシュ（KV）',
    data: 'アクセスログ（IPアドレスを含む）、写真データ',
    country: 'アメリカ合衆国（グローバルCDN）',
    measures: 'SOC2 Type II認証取得、ISO 27001認証取得、GDPR準拠',
  },
  {
    name: 'Stripe',
    purpose: '決済処理',
    data: '決済に必要な情報（クレジットカード情報はStripe社が直接管理）',
    country: 'アメリカ合衆国',
    measures: 'PCI DSS Level 1認証取得、SOC2認証取得',
  },
  {
    name: 'Google',
    purpose: 'OAuth認証（Googleアカウントでのログイン）',
    data: '認証情報（メールアドレス、プロフィール画像URL）',
    country: 'アメリカ合衆国',
    measures: 'SOC2/3認証取得、ISO 27001認証取得、GDPR準拠',
  },
  {
    name: 'LINE',
    purpose: 'OAuth認証（LINEアカウントでのログイン）',
    data: '認証情報（LINEユーザーID、表示名、プロフィール画像URL）',
    country: '日本（LINE株式会社）',
    measures: '個人情報保護法に基づく適切な管理',
  },
  {
    name: 'Open-Meteo',
    purpose: '天気情報の自動取得',
    data: '位置座標（天気データ取得のためにAPIに送信。ユーザー登録やAPIキーは不要）',
    country: 'ドイツ',
    measures: 'GDPR準拠、オープンソースプロジェクト',
  },
  {
    name: 'MapLibre / OpenStreetMap',
    purpose: '地図の表示',
    data: '地図タイル取得時にIPアドレスがタイルサーバーに送信されます（位置座標は送信されません）',
    country: '各国（分散型タイルサーバー）',
    measures: 'オープンソースプロジェクト、地図タイルの取得のみ',
  },
];

// 外部送信に関する公表事項（電気通信事業法第27条の12）
const externalServices = [
  {
    name: 'Supabase',
    data: '認証トークン、ユーザーID、利用データ',
    purpose: 'ユーザー認証、データの保存・取得',
    optout: '本サービスの利用に必要なため、オプトアウトはできません',
  },
  {
    name: 'Cloudflare',
    data: 'IPアドレス、アクセスログ',
    purpose: 'ウェブサイトのホスティング・配信の最適化・セキュリティ対策',
    optout: '本サービスの利用に必要なため、オプトアウトはできません',
  },
  {
    name: 'Stripe',
    data: '決済関連情報（カード情報はStripeが直接管理）',
    purpose: '決済処理',
    optout: '有料プランをご利用の場合に必要なため、オプトアウトはできません',
  },
  {
    name: 'Google',
    data: '認証情報（メールアドレス、プロフィール画像URL）',
    purpose: 'Googleアカウントを使ったOAuth認証',
    optout: 'Googleでのログインを利用しない場合はPasskeyまたは他の認証方法をご利用ください',
  },
  {
    name: 'LINE',
    data: '認証情報（LINEユーザーID、表示名、プロフィール画像URL）',
    purpose: 'LINEアカウントを使ったOAuth認証',
    optout: 'LINEでのログインを利用しない場合はPasskeyまたは他の認証方法をご利用ください',
  },
  {
    name: 'Open-Meteo',
    data: '位置座標（散歩地点の緯度・経度）',
    purpose: '天気・気温データの自動取得',
    optout: '天気の自動取得機能を利用しない場合は、散歩記録時にスキップできます',
  },
  {
    name: 'OpenStreetMap（タイルサーバー）',
    data: 'IPアドレス（地図タイル取得時）',
    purpose: '地図表示のためのタイル画像の取得',
    optout: '地図表示は本サービスの中核機能のため、オプトアウトはできません',
  },
];

// お客様の権利
const rightsItems = [
  '保有個人データの開示請求',
  '保有個人データの訂正・追加・削除請求',
  '保有個人データの利用停止・消去請求',
  '保有個人データの第三者提供停止請求',
];

const badge =
  'w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0';
---

<Layout
  title={t.pages.privacy.title}
  description={t.pages.privacy.description}
  ogType="article"
  dateModified={PRIVACY_LAST_MODIFIED}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={[{ name: t.footer.privacy, url: '/privacy' }]} />

    <div class="mb-10">
      <h1 class="text-4xl font-display font-bold text-warm-gray-900 mb-3 hero-slide-in-left">
        {t.footer.privacy}
      </h1>
      <div class="w-14 h-1 bg-primary-400 rounded-full hero-slide-in-left"></div>
      <p class="text-sm text-warm-gray-500 mt-4">最終更新日: 2026年4月25日</p>
    </div>

    <div class="bg-white rounded-card border border-warm-gray-100 divide-y divide-warm-gray-100 fade-in-up">
      <!-- 1. はじめに -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>1</span>
          はじめに
        </h2>
        <div class="pl-10 space-y-3 text-warm-gray-700">
          <p>
            Tikareta（おさんぽタイプ。以下「本サービス」）は、愛犬との毎日のおさんぽを記録・分析し、休憩データ（場所・時刻・天気・理由）などから愛犬の「おさんぽタイプ」を診断するWebアプリ（PWA）です。本サービスは、散歩記録・お気に入りスポットの保存・タイプ診断・飼い主同士のコミュニティ機能を提供します。
          </p>
          <p>
            本サービスは、お客様の個人情報の保護を重要と考え、個人情報の保護に関する法律（以下「個人情報保護法」）を遵守し、以下のとおりプライバシーポリシー（以下「本ポリシー」）を定めます。本ポリシーは、本サービスをご利用いただくすべてのお客様に適用されます。本サービスのご利用に際しては、アカウント登録時に利用規約とともに本ポリシーへの同意を取得しています。
          </p>
        </div>
      </section>

      <!-- 2. 事業者情報 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>2</span>
          事業者情報・お問い合わせ窓口
        </h2>
        <div class="pl-10 space-y-2 text-warm-gray-700">
          <p>
            本サービスの運営者情報（特定商取引法に基づく表記）は、ご請求に応じて遅滞なく開示します。個人情報の取り扱いに関するお問い合わせ窓口は以下のとおりです。
          </p>
          <p>
            連絡先メールアドレス:
            <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary-700 underline break-all">{CONTACT_EMAIL}</a>
          </p>
          <p class="text-sm text-warm-gray-500">本サービスは、認定個人情報保護団体には加入していません。</p>
        </div>
      </section>

      <!-- 3. 収集する個人情報 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>3</span>
          収集する個人情報
        </h2>
        <p class="text-warm-gray-700 pl-10 mb-4">本サービスでは、以下の個人情報を収集・利用します。</p>
        <div class="pl-10 grid gap-3 sm:grid-cols-2">
          {dataCategories.map((c) => (
            <div class="rounded-soft bg-warm-gray-50 border border-warm-gray-100 p-4">
              <h3 class="font-semibold text-warm-gray-900 text-sm mb-1.5">{c.name}</h3>
              <p class="text-sm text-warm-gray-600 mb-1"><span class="text-warm-gray-400">取得する情報: </span>{c.items}</p>
              <p class="text-sm text-warm-gray-600"><span class="text-warm-gray-400">利用目的: </span>{c.purpose}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. 利用目的 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>4</span>
          個人情報の利用目的
        </h2>
        <p class="text-warm-gray-700 pl-10 mb-2">本サービスでは、収集した個人情報を以下の目的で利用します。</p>
        <ul class="list-disc list-inside text-warm-gray-700 space-y-1.5 pl-10">
          {purposeItems.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <!-- 5. Googleユーザーデータの取り扱い（Google OAuth） -->
      <section class="p-8 scroll-mt-24" id="google-oauth">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>5</span>
          Googleユーザーデータの取り扱い（Google OAuth）
        </h2>
        <div class="pl-10 space-y-4 text-warm-gray-700">
          <p>
            本サービスは、ログイン手段の一つとして Google アカウントによる認証（Google OAuth 2.0）を提供しています。Google アカウントでログインする場合に限り、お客様の同意のもとで以下の範囲（スコープ）の情報を Google から取得します。本サービスが要求するのは Google の非機微（non-sensitive）スコープのみで、Gmail・カレンダー・ドライブ等の制限付き（restricted / sensitive）スコープは一切要求しません。Google アカウントを利用しない場合は、LINE または Passkey による認証をご利用いただけます。
          </p>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="border-b border-warm-gray-200 text-left">
                  <th class="py-2 pr-4 font-semibold text-warm-gray-900 align-top whitespace-nowrap">スコープ</th>
                  <th class="py-2 font-semibold text-warm-gray-900 align-top">取得するデータと利用目的</th>
                </tr>
              </thead>
              <tbody>
                {googleScopes.map((s) => (
                  <tr class="border-b border-warm-gray-100 align-top">
                    <td class="py-2 pr-4"><code class="text-xs bg-warm-gray-100 rounded px-1.5 py-0.5 text-warm-gray-700 break-all">{s.scope}</code></td>
                    <td class="py-2 text-warm-gray-600">{s.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="rounded-soft bg-primary-50 border border-primary-100 p-4 space-y-2 text-sm">
            <p class="font-semibold text-warm-gray-900">取得した Google ユーザーデータの取り扱い</p>
            <ul class="list-disc list-inside space-y-1.5 text-warm-gray-700">
              <li><span class="font-medium">利用目的の限定:</span> 取得した情報は、上記のアカウント認証およびサービス内表示の目的にのみ利用し、それ以外の目的には利用しません。</li>
              <li><span class="font-medium">第三者提供の禁止:</span> Google ユーザーデータを第三者に販売・貸与・譲渡することはありません。広告目的で利用することもありません。</li>
              <li><span class="font-medium">保管と削除:</span> 取得した情報は認証基盤である Supabase Auth に安全に保管されます。お客様はいつでもアプリの設定画面からアカウントを削除し、これらの情報を消去できます。</li>
              <li><span class="font-medium">Limited Use の遵守:</span> 本サービスによる Google API から受領した情報の使用および他アプリへの転送は、限定使用要件（Limited Use requirements）を含む <a href="https://developers.google.com/terms/api-services-user-data-policy" class="text-primary-700 underline" target="_blank" rel="noopener noreferrer">Google API Services User Data Policy</a> に準拠します。</li>
              <li><span class="font-medium">連携の解除:</span> お客様は <a href="https://myaccount.google.com/permissions" class="text-primary-700 underline" target="_blank" rel="noopener noreferrer">Google アカウントのセキュリティ設定</a> から、いつでも本サービスへのアクセス権を取り消すことができます。</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 6. 第三者サービスの利用 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>6</span>
          第三者サービスの利用
        </h2>
        <p class="text-warm-gray-700 pl-10 mb-4">
          本サービスでは、以下の第三者サービスを利用しており、これらのサービスにお客様の個人情報の一部を提供する場合があります。各サービスの個人情報の取り扱いについては、各サービスのプライバシーポリシーをご確認ください。
        </p>
        <div class="pl-10 grid gap-3 sm:grid-cols-2">
          {thirdPartyServices.map((s) => (
            <div class="rounded-soft bg-warm-gray-50 border border-warm-gray-100 p-4">
              <h3 class="font-semibold text-warm-gray-900 text-sm mb-1.5">{s.name}</h3>
              <p class="text-sm text-warm-gray-600 mb-1"><span class="text-warm-gray-400">目的: </span>{s.purpose}</p>
              <p class="text-sm text-warm-gray-600 mb-1"><span class="text-warm-gray-400">提供する情報: </span>{s.data}</p>
              <p class="text-sm text-warm-gray-600"><span class="text-warm-gray-400">所在国／保護措置: </span>{s.country}／{s.measures}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 7. 外部送信に関する公表事項 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>7</span>
          外部送信に関する公表事項
        </h2>
        <p class="text-warm-gray-700 pl-10 mb-4">
          電気通信事業法第27条の12に基づき、本サービスが利用者の端末から外部に送信する情報について以下のとおり公表します。
        </p>
        <div class="pl-10 grid gap-3 sm:grid-cols-2">
          {externalServices.map((s) => (
            <div class="rounded-soft bg-warm-gray-50 border border-warm-gray-100 p-4">
              <h3 class="font-semibold text-warm-gray-900 text-sm mb-1.5">{s.name}</h3>
              <p class="text-sm text-warm-gray-600 mb-1"><span class="text-warm-gray-400">送信される情報: </span>{s.data}</p>
              <p class="text-sm text-warm-gray-600 mb-1"><span class="text-warm-gray-400">目的: </span>{s.purpose}</p>
              <p class="text-sm text-warm-gray-600"><span class="text-warm-gray-400">オプトアウト: </span>{s.optout}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- 8. 匿名化・集計データの利用 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>8</span>
          匿名化・集計データの利用
        </h2>
        <div class="pl-10 space-y-2 text-warm-gray-700">
          <p>本サービスでは、以下の場合において、個人を特定できない形に匿名化・集計したデータを利用することがあります。</p>
          <ul class="list-disc list-inside space-y-1.5">
            <li>「みんなの休憩ポイント」機能: 全ユーザーの休憩スポットデータを50メートル四方のグリッドに集計し、個人の正確な位置を特定できない形でヒートマップとして表示します。</li>
            <li>「今日の休憩トレンド」機能: 休憩理由の統計データを集計し、匿名化された形でトレンド情報を表示します。</li>
            <li>「同犬種との比較」機能: 同じ犬種のデータを統計的に集計し、個々のユーザーを特定できない形で比較データを提供します。</li>
          </ul>
          <p>これらの匿名化・集計データは、個人を識別できない統計情報として処理しており、個人情報保護法第2条第6項に定める「匿名加工情報」の作成には該当しません。</p>
        </div>
      </section>

      <!-- 9. 第三者提供 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>9</span>
          個人情報の第三者提供
        </h2>
        <div class="pl-10 space-y-2 text-warm-gray-700">
          <p>本サービスは、以下の場合を除き、お客様の個人情報を第三者に提供しません。</p>
          <ul class="list-disc list-inside space-y-1.5">
            <li>お客様の同意がある場合（コミュニティへの投稿共有など、お客様がオプトインした場合）</li>
            <li>法令に基づく場合</li>
            <li>人の生命、身体または財産の保護のために必要がある場合であって、お客様の同意を得ることが困難である場合</li>
            <li>公衆衛生の向上または児童の健全な育成の推進のために特に必要がある場合</li>
            <li>国の機関もしくは地方公共団体またはその委託を受けた者が法令の定める事務を遂行することに対して協力する必要がある場合</li>
          </ul>
          <p>本サービスは、お客様の個人情報を販売することはありません。</p>
        </div>
      </section>

      <!-- 10. データの保持期間 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>10</span>
          データの保持期間
        </h2>
        <div class="pl-10 space-y-2 text-warm-gray-700">
          <p>お客様の個人情報は、アカウントが有効な間保持します。アカウントを削除された場合、お客様に紐づくすべてのデータ（散歩記録、スポット情報、写真、犬の情報等）は速やかに完全に削除されます。</p>
          <p>データカテゴリ別の保持期間は以下のとおりです。</p>
          <ul class="list-disc list-inside space-y-1.5">
            <li>アクセスログ（IPアドレス等）: 90日間</li>
            <li>決済記録: 法人税法に基づき7年間</li>
            <li>バックアップデータ: アカウント削除後30日以内に完全削除</li>
            <li>匿名化・集計データ: 個人情報に該当しないため、アカウント削除後も統計データとして保持</li>
          </ul>
          <p>なお、上記以外に法令により保持が義務付けられている情報については、当該法令で定められた期間保持します。</p>
        </div>
      </section>

      <!-- 11. 安全管理措置 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>11</span>
          安全管理措置
        </h2>
        <div class="pl-10 space-y-2 text-warm-gray-700">
          <p>本サービスは、お客様の個人情報を適切に保護するため、以下の安全管理措置を講じています。</p>
          <ul class="list-disc list-inside space-y-1.5">
            <li>すべてのデータベースアクセスに行レベルセキュリティ（RLS）を適用し、ユーザーは自分のデータのみにアクセス可能</li>
            <li>HTTPSによる通信の暗号化</li>
            <li>セキュリティヘッダー（CSP、HSTS等）の設定</li>
            <li>決済情報はStripe社が直接管理し、本サービスのサーバーには保存しません</li>
            <li>アクセス権限の最小化原則の適用</li>
            <li>APIエンドポイントへのレート制限の適用</li>
            <li>定期的なセキュリティレビューの実施</li>
          </ul>
        </div>
      </section>

      <!-- 12. お客様の権利 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>12</span>
          お客様の権利
        </h2>
        <div class="pl-10 space-y-2 text-warm-gray-700">
          <p>お客様は、個人情報保護法に基づき、以下の権利を有しています。</p>
          <ul class="list-disc list-inside space-y-1.5">
            {rightsItems.map((item) => <li>{item}</li>)}
          </ul>
          <p>上記の権利を行使される場合は、上記のお問い合わせ窓口までご連絡ください。本人確認を行った上で、合理的な期間内（原則として2週間以内）に対応いたします。また、設定画面からアカウントを削除することで、すべての個人データを削除することもできます。</p>
        </div>
      </section>

      <!-- 13. Cookieおよびローカルストレージ -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>13</span>
          Cookieおよびローカルストレージ
        </h2>
        <div class="pl-10 space-y-2 text-warm-gray-700">
          <p>本サービスでは、以下の技術を使用しています。</p>
          <ul class="list-disc list-inside space-y-1.5">
            <li>セッションCookie: ユーザー認証の維持に使用します。本サービスの利用に必要なため、無効にすることはできません。</li>
            <li>言語設定Cookie: お客様の言語設定を保持するために使用します。</li>
            <li>ローカルストレージ / IndexedDB: PWA（プログレッシブウェブアプリ）のオフライン機能のために使用します。GPS追跡データをオフライン時に一時保存し、オンライン復帰時にサーバーと同期します。</li>
          </ul>
          <p>お客様はブラウザの設定でCookieを無効にすることができますが、その場合、本サービスの一部の機能が利用できなくなる場合があります。アクセス解析にはCookieを使用しないCloudflare Web Analyticsを使用しています。</p>
        </div>
      </section>

      <!-- 14. お子様のプライバシー -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>14</span>
          お子様のプライバシー
        </h2>
        <p class="text-warm-gray-700 pl-10">
          本サービスは、16歳未満のお子様を対象としたサービスではありません。16歳未満の方が本サービスを利用される場合は、保護者の同意が必要です。16歳未満のお子様の個人情報を意図せず収集していることが判明した場合は、速やかに削除いたします。
        </p>
      </section>

      <!-- 15. 本ポリシーの変更 -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>15</span>
          本ポリシーの変更
        </h2>
        <p class="text-warm-gray-700 pl-10">
          本ポリシーは、法令の改正やサービスの変更に応じて更新される場合があります。重要な変更がある場合は、本サービス上での通知またはメールにてお知らせします。変更後のポリシーは、本サービス上に掲載された時点で効力を生じるものとします。
        </p>
      </section>

      <!-- 16. お問い合わせ -->
      <section class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class={badge}>16</span>
          お問い合わせ
        </h2>
        <p class="text-warm-gray-700 pl-10">
          本ポリシーに関するお問い合わせは、以下の連絡先までお願いいたします。<br />
          <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary-700 underline break-all">{CONTACT_EMAIL}</a>
        </p>
      </section>
    </div>

    <p class="text-sm text-warm-gray-500 mt-6 fade-in-up">最終更新日: 2026年4月25日</p>
  </div>
</Layout>
