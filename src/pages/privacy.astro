---
import Breadcrumbs from '@components/common/Breadcrumbs.astro';
import Layout from '@layouts/Layout.astro';
import { useTranslations } from '@utils/i18n';
import {
  createBreadcrumbListLD,
  createWebPageLD,
  getPageUrl,
} from '@utils/seo';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'ja';
const lastModified = '2026-02-15';
const pageUrl = getPageUrl(locale, '/privacy');

const breadcrumbJsonLd = createBreadcrumbListLD([
  { name: t.nav.home, url: getPageUrl(locale, '/') },
  { name: t.footer.privacy, url: pageUrl },
]);

const webPageJsonLd = createWebPageLD({
  locale,
  name: t.pages.privacy.title,
  description: t.pages.privacy.description,
  url: pageUrl,
  dateModified: lastModified,
});

const jsonLd = [webPageJsonLd, breadcrumbJsonLd];
---

<Layout
  title={t.pages.privacy.title}
  description={t.pages.privacy.description}
  ogType="article"
  dateModified={lastModified}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <Breadcrumbs items={[{ name: t.footer.privacy, url: '/privacy' }]} />

    <div class="mb-10">
      <h1 class="text-4xl font-display font-bold text-warm-gray-900 mb-3 hero-slide-in-left">
        {t.footer.privacy}
      </h1>
      <div class="w-14 h-1 bg-primary-400 rounded-full hero-slide-in-left"></div>
    </div>

    <div class="bg-white rounded-card border border-warm-gray-100 divide-y divide-warm-gray-100 fade-in-up">
      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">1</span>
          個人情報の取り扱いについて
        </h2>
        <p class="text-warm-gray-700 pl-10">
          おさんぽタイプ（以下「当サービス」）は、ユーザーの個人情報を適切に管理し、個人情報保護法に準拠して取り扱います。
        </p>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">2</span>
          収集する情報
        </h2>
        <ul class="list-disc list-inside text-warm-gray-700 space-y-1.5 pl-10">
          <li>メールアドレス</li>
          <li>ペットのプロフィール情報（犬種、年齢、名前など）</li>
          <li>散歩記録（GPS位置情報、時刻、距離など）</li>
          <li>休憩スポット情報（位置情報、写真、メモなど）</li>
          <li>利用状況データ</li>
        </ul>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">3</span>
          情報の利用目的
        </h2>
        <ul class="list-disc list-inside text-warm-gray-700 space-y-1.5 pl-10">
          <li>サービスの提供・運営</li>
          <li>おさんぽタイプ診断の実施</li>
          <li>統計データの作成・分析</li>
          <li>サービスの改善・新機能の開発</li>
          <li>お問い合わせへの対応</li>
        </ul>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">4</span>
          情報の第三者提供
        </h2>
        <p class="text-warm-gray-700 pl-10">
          当サービスは、法令に基づく場合を除き、ユーザーの同意なく個人情報を第三者に提供することはありません。
        </p>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">5</span>
          位置情報の取り扱い
        </h2>
        <p class="text-warm-gray-700 pl-10">
          GPS位置情報は散歩記録の作成にのみ使用され、ユーザーが明示的に共有設定を行わない限り、他のユーザーに公開されることはありません。
        </p>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">6</span>
          データの保持期間
        </h2>
        <p class="text-warm-gray-700 pl-10">
          アカウント削除後も、法令で定められた期間はデータを保持する場合があります。
        </p>
      </div>

      <div class="p-8">
        <h2 class="text-lg font-bold text-warm-gray-900 mb-3 flex items-center gap-3">
          <span class="w-7 h-7 bg-primary-100 rounded-soft flex items-center justify-center text-sm font-bold text-primary-700 flex-shrink-0">7</span>
          お問い合わせ
        </h2>
        <p class="text-warm-gray-700 pl-10">
          プライバシーポリシーに関するお問い合わせは、サービス内のお問い合わせフォームよりご連絡ください。
        </p>
      </div>
    </div>

    <p class="text-sm text-warm-gray-500 mt-6 fade-in-up">
      最終更新日: 2026年2月15日
    </p>
  </div>
</Layout>
