---
import { comparisonFeatures, plans } from '@data/pricing';
import { useTranslations } from '@utils/i18n';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'ja';

type FeatureKey = keyof typeof t.features;

// WCAG 1.1.1: チェックマーク・ダッシュのスクリーンリーダー用テキスト
const srYes = locale === 'ja' ? '○' : 'Yes';
const srNo = locale === 'ja' ? '×' : 'No';

const planByKey = Object.fromEntries(plans.map((p) => [p.key, p]));
const standardYearlyPerMonth = Math.round(planByKey.standard.yearly / 12);
const proYearlyPerMonth = Math.round(planByKey.pro.yearly / 12);
---

<section class="bg-white rounded-card border border-warm-gray-100 p-6 sm:p-8 fade-in-up">
  <h2 class="text-2xl font-bold text-warm-gray-900 mb-2">
    {t.pricing.comparison.title}
  </h2>
  <div class="w-10 h-1 bg-primary-400 rounded-full mb-6"></div>

  <div class="overflow-x-auto -mx-6 px-6 sm:-mx-8 sm:px-8">
    <table class="w-full min-w-[560px] border-collapse">
      <thead>
        <tr class="border-b-2 border-warm-gray-100">
          <th class="sticky left-0 z-10 bg-white py-3 pr-4 text-left text-sm font-bold text-warm-gray-600 min-w-[160px]">
            {t.pricing.comparison.feature}
          </th>
          <th class="py-3 px-3 text-center text-sm font-bold text-warm-gray-900 min-w-[100px]">
            {t.pricing.plans.free.name}
            <div class="text-xs font-normal text-warm-gray-500 mt-0.5">¥0</div>
          </th>
          <th class="py-3 px-3 text-center text-sm font-bold text-warm-gray-900 min-w-[100px] bg-primary-50 rounded-t-soft">
            <div class="flex flex-col items-center gap-0.5">
              <!-- WCAG 1.4.3: primary-700(#c2410c)+white = 4.79:1 ✓ -->
              <span class="inline-block px-2 py-0.5 bg-primary-700 text-white text-xs font-bold rounded-soft">
                {t.pricing.recommended}
              </span>
              {t.pricing.plans.standard.name}
              <span class="text-xs font-normal text-warm-gray-500">¥{planByKey.standard.monthly}{t.pricing.perMonth}</span>
              <span class="text-xs font-normal text-warm-gray-400">/ ¥{standardYearlyPerMonth}{t.pricing.perMonth}（{t.pricingSummary.billingYearly}）</span>
            </div>
          </th>
          <th class="py-3 px-3 text-center text-sm font-bold text-warm-gray-900 min-w-[100px]">
            {t.pricing.plans.pro.name}
            <div class="text-xs font-normal text-warm-gray-500 mt-0.5">¥{planByKey.pro.monthly}{t.pricing.perMonth}</div>
            <div class="text-xs font-normal text-warm-gray-400">/ ¥{proYearlyPerMonth}{t.pricing.perMonth}（{t.pricingSummary.billingYearly}）</div>
          </th>
        </tr>
      </thead>
      <tbody>
        {comparisonFeatures.map((feature, i) => (
          <tr class={`border-b border-warm-gray-100 ${i % 2 === 0 ? '' : 'bg-cream-50/50'}`}>
            <td class={`sticky left-0 z-10 py-3 pr-4 text-sm text-warm-gray-800 ${i % 2 === 0 ? 'bg-white' : 'bg-cream-50/50'}`}>
              {t.features[feature.nameKey as FeatureKey].title}
            </td>
            <td class="py-3 px-3 text-center">
              {feature.free ? (
                <>
                  {/* WCAG 1.1.1: 情報SVGに代替テキスト、WCAG 1.4.11: secondary-600(#16a34a) on white = 3.06:1 ✓ */}
                  <span class="sr-only">{srYes}</span>
                  <svg class="w-5 h-5 text-secondary-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </>
              ) : (
                <>
                  {/* WCAG 1.1.1: ダッシュに代替テキスト */}
                  <span class="sr-only">{srNo}</span>
                  <span class="text-warm-gray-400" aria-hidden="true">—</span>
                </>
              )}
            </td>
            <td class="py-3 px-3 text-center bg-primary-50/50">
              {feature.standard ? (
                <>
                  <span class="sr-only">{srYes}</span>
                  <svg class="w-5 h-5 text-secondary-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </>
              ) : (
                <>
                  <span class="sr-only">{srNo}</span>
                  <span class="text-warm-gray-400" aria-hidden="true">—</span>
                </>
              )}
            </td>
            <td class="py-3 px-3 text-center">
              {feature.pro ? (
                <>
                  <span class="sr-only">{srYes}</span>
                  <svg class="w-5 h-5 text-secondary-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </>
              ) : (
                <>
                  <span class="sr-only">{srNo}</span>
                  <span class="text-warm-gray-400" aria-hidden="true">—</span>
                </>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
