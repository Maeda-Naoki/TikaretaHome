---
import { APP_COMING_SOON } from '@data/navigation';
import { format, savingsMonths, useTranslations } from '@utils/i18n';

interface Props {
  planKey: 'free' | 'standard' | 'pro';
  name: string;
  monthly: number;
  yearly: number;
  features: string[];
  cta: string;
  recommended?: boolean;
}

const { planKey, name, monthly, yearly, features, cta, recommended = false } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'ja';

// WCAG 1.1.1: チェックマークのスクリーンリーダー用テキスト
const srYes = locale === 'ja' ? '○' : 'Yes';

const isFree = monthly === 0 && yearly === 0;
const yearlyPerMonth = yearly > 0 ? Math.round(yearly / 12) : 0;
const months = savingsMonths(monthly, yearly);
const savingsText = months > 0 ? format(t.pricing.savingsMonthsTemplate, { months }) : '';
const monthlyEquivText = yearlyPerMonth > 0 ? format(t.pricing.monthlyEquivTemplate, { amount: yearlyPerMonth.toLocaleString() }) : '';
---

<div
  class:list={[
    "pricing-card rounded-card transition-all scale-in flex flex-col h-full",
    recommended
      ? "bg-primary-50 border-2 border-primary-700 shadow-lifted p-8 md:-mt-4 md:mb-4"
      : "bg-white border border-warm-gray-100 shadow-soft hover:shadow-card p-7"
  ]}
  data-plan={planKey}
>
  {recommended && (
    <!-- WCAG 1.4.3: primary-700(#c2410c)+white = 4.79:1 ✓ -->
    <div class="inline-block px-3 py-1 bg-primary-700 text-white text-xs font-bold tracking-wide uppercase rounded-soft mb-4">
      {t.pricing.recommended}
    </div>
  )}
  <h2 class="text-2xl font-bold text-warm-gray-900 mb-4">{name}</h2>
  <div class="mb-5 flex items-baseline gap-1">
    {isFree ? (
      <span class:list={["font-bold text-warm-gray-900", recommended ? "text-5xl" : "text-4xl"]}>
        {t.pricing.freeLabel}
      </span>
    ) : (
      <>
        <span
          class:list={[
            "billing-monthly font-bold text-warm-gray-900",
            recommended ? "text-5xl" : "text-4xl",
          ]}
        >
          ¥{monthly.toLocaleString()}
        </span>
        <span class="billing-monthly text-warm-gray-500 text-sm">{t.pricing.perMonth}</span>
        <span
          class:list={[
            "billing-yearly font-bold text-warm-gray-900",
            recommended ? "text-5xl" : "text-4xl",
          ]}
        >
          ¥{yearly.toLocaleString()}
        </span>
        <span class="billing-yearly text-warm-gray-500 text-sm">{t.pricing.perYear}</span>
      </>
    )}
  </div>
  {!isFree && (
    <div class="billing-yearly mb-4 text-secondary-700 font-bold text-sm">
      {monthlyEquivText}{savingsText && ` — ${savingsText}`}
    </div>
  )}
  <ul class="space-y-2.5 mb-8 flex-1">
    {features.map((feature) => (
      <li class="flex items-start gap-2 text-sm text-warm-gray-700">
        {/* WCAG 1.1.1: 情報SVGに代替テキスト、WCAG 1.4.11: secondary-600(#16a34a) on white = 3.06:1 ✓ */}
        <span class="sr-only">{srYes}</span>
        <svg class="w-4 h-4 text-secondary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
        </svg>
        {feature}
      </li>
    ))}
  </ul>
  {APP_COMING_SOON ? (
    <span
      class:list={[
        "block text-center font-bold py-3 px-6 rounded-button cursor-default opacity-60",
        recommended
          ? "bg-primary-700 text-white"
          : "bg-warm-gray-50 text-warm-gray-800 border border-warm-gray-200"
      ]}
    >
      {t.common.comingSoon}
    </span>
  ) : (
    <!-- WCAG 3.2.5: target="_blank" に sr-only で通知 -->
    <a
      href="https://tikareta.com"
      class:list={[
        "block text-center font-bold py-3 px-6 rounded-button transition-all duration-300",
        recommended
          ? "bg-primary-700 hover:bg-primary-800 text-white shadow-soft hover:shadow-hover"
          : "bg-warm-gray-50 hover:bg-warm-gray-100 text-warm-gray-800 border border-warm-gray-200"
      ]}
      target="_blank"
      rel="noopener noreferrer"
    >
      {cta}
      <span class="sr-only">{t.common.newTab}</span>
    </a>
  )}
</div>

<style>
  /* `[data-billing]` is set on a parent wrapper by BillingToggle.
     `:global(...)` opts out of Astro's component scoping so the wrapper match works. */
  .pricing-card .billing-yearly { display: none; }
  :global([data-billing="yearly"]) .pricing-card .billing-monthly { display: none; }
  :global([data-billing="yearly"]) .pricing-card .billing-yearly { display: inline; }
  :global([data-billing="yearly"]) .pricing-card div.billing-yearly { display: block; }
</style>
