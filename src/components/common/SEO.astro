---
import { useTranslations } from '@utils/i18n';
import { getOGImageUrl } from '@utils/seo';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  datePublished?: string;
  dateModified?: string;
  jsonLd?: unknown;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  noindex = false,
  keywords,
  datePublished,
  dateModified,
  jsonLd,
} = Astro.props;
const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);

// Canonical URL
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Alternate URLs for hreflang
const basePath = Astro.url.pathname.replace(/^\/en/, '');
const jaUrl = new URL(basePath, Astro.site).href;
const enUrl = new URL(`/en${basePath}`, Astro.site).href;

// OGP image
const ogImagePath = ogImage ?? getOGImageUrl(locale);
const ogImageFullUrl = new URL(ogImagePath, Astro.site).href;
const ogImagePathLower = ogImagePath.toLowerCase();
const ogImageMime = ogImagePathLower.endsWith('.svg')
  ? 'image/svg+xml'
  : ogImagePathLower.endsWith('.png')
    ? 'image/png'
    : ogImagePathLower.endsWith('.webp')
      ? 'image/webp'
      : 'image/jpeg';

// OG locale + alternate locale
const ogLocale = locale === 'ja' ? 'ja_JP' : 'en_US';
const ogLocaleAlternate = locale === 'ja' ? 'en_US' : 'ja_JP';

// Site / brand strings (single source of truth from translations)
const siteName = t.site.name;

// Default OG image alt (used when caller doesn't supply one)
const defaultOgImageAlt = `${siteName} - ${t.site.tagline}`;
const finalOgImageAlt = ogImageAlt ?? defaultOgImageAlt;

// Google Search Console verification
const googleSiteVerification = import.meta.env.GOOGLE_SITE_VERIFICATION;

// Keywords (comma-separated for the meta tag)
const keywordsContent = keywords && keywords.length > 0 ? keywords.join(', ') : null;
---

<!-- Basic meta tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
{keywordsContent && <meta name="keywords" content={keywordsContent} />}
<meta name="author" content={siteName} />
<meta name="format-detection" content="telephone=no" />
<meta name="theme-color" content="#F97316" />
<meta name="color-scheme" content="light" />
{noindex ? (
  <meta name="robots" content="noindex,nofollow" />
) : (
  <meta
    name="robots"
    content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
  />
)}

{googleSiteVerification && (
  <meta name="google-site-verification" content={googleSiteVerification} />
)}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- hreflang -->
<link rel="alternate" hreflang="ja" href={jaUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={jaUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageFullUrl} />
<meta property="og:image:type" content={ogImageMime} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={finalOgImageAlt} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />
<meta property="og:site_name" content={siteName} />

{ogType === 'article' && datePublished && (
  <meta property="article:published_time" content={datePublished} />
)}
{ogType === 'article' && dateModified && (
  <meta property="article:modified_time" content={dateModified} />
)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageFullUrl} />
<meta name="twitter:image:alt" content={finalOgImageAlt} />

<!-- JSON-LD -->
{
  jsonLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  )
}
