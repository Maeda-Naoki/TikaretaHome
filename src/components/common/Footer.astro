---
import { APP_COMING_SOON } from '@data/navigation';
import { useTranslations } from '@utils/i18n';
import LogoMark from './LogoMark.astro';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);
const p = (path: string) => (locale === 'ja' ? path : `/en${path}`);
---

<footer class="foot">
  <div class="container-page">
    <div class="foot-grid">
      <div>
        <div class="row" style="gap:.55rem; font-weight:800; font-size:1.05rem; margin-bottom:.85rem;">
          <LogoMark />
          <span>Tikareta</span>
        </div>
        <p style="font-size:.88rem; color:var(--ink-soft); line-height:1.6; max-width:260px;">
          {t.footer.tagline}
        </p>
      </div>

      <div>
        <h3>{t.footer.serviceTitle}</h3>
        <ul>
          <li><a href={p('/features')}>{t.nav.features}</a></li>
          <li><a href={p('/pricing')}>{t.nav.pricing}</a></li>
          <li><a href={p('/faq')}>{t.nav.faq}</a></li>
          <li><a href={p('/roadmap')}>{t.nav.roadmap}</a></li>
        </ul>
      </div>

      <div>
        <h3>{t.footer.appTitle}</h3>
        <ul>
          <li>
            {APP_COMING_SOON ? (
              <span style="cursor:default; opacity:.55;">{t.footer.openWebApp} — {t.common.comingSoon}</span>
            ) : (
              <a href="https://tikareta.com" target="_blank" rel="noopener">{t.footer.openWebApp}</a>
            )}
          </li>
          <li><span style="opacity:.55;">{t.footer.iosApp}</span></li>
          <li><span style="opacity:.55;">{t.footer.androidApp}</span></li>
        </ul>
      </div>

      <div>
        <h3>{t.footer.legalTitle}</h3>
        <ul>
          <li><a href={p('/privacy')}>{t.footer.privacy}</a></li>
          <li><a href={p('/terms')}>{t.footer.terms}</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© 2026 Tikareta. All rights reserved.</span>
      <span>Made with 🐾 for dog owners</span>
    </div>
  </div>
</footer>

<style>
  .foot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
