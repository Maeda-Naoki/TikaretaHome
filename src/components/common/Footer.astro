---
import LogoMark from './LogoMark.astro';

const locale = Astro.currentLocale ?? 'ja';
const p = (path: string) => (locale === 'ja' ? path : `/en${path}`);
---

<footer class="foot">
  <div class="container-page">
    <div class="foot-grid">
      <div>
        <div class="row" style="gap:.55rem; font-weight:800; font-size:1.05rem; margin-bottom:.85rem;">
          <LogoMark />
          <span>Tikareta</span>
        </div>
        <p style="font-size:.88rem; color:var(--ink-soft); line-height:1.6; max-width:260px;">
          うちの子のおさんぽスタイル、知ってる？毎日の記録から愛犬の個性が見えてきます。
        </p>
      </div>

      <div>
        <h5>サービス</h5>
        <ul>
          <li><a href={p('/features')}>機能紹介</a></li>
          <li><a href={p('/pricing')}>料金プラン</a></li>
          <li><a href={p('/faq')}>よくある質問</a></li>
          <li><a href={p('/roadmap')}>ロードマップ</a></li>
        </ul>
      </div>

      <div>
        <h5>アプリ</h5>
        <ul>
          <li><a href="https://tikareta.com" target="_blank" rel="noopener">Webアプリを開く</a></li>
          <li><a href="#">iOSアプリ（準備中）</a></li>
          <li><a href="#">Androidアプリ（準備中）</a></li>
        </ul>
      </div>

      <div>
        <h5>法的情報</h5>
        <ul>
          <li><a href={p('/privacy')}>プライバシーポリシー</a></li>
          <li><a href={p('/terms')}>利用規約</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© 2026 Tikareta. All rights reserved.</span>
      <span>Made with 🐾 for dog owners</span>
    </div>
  </div>
</footer>

<style>
  .foot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
  }
  @media (max-width: 760px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
