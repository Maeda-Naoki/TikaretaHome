---
import { useTranslations } from '@utils/i18n';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'ja';
---

<footer class="bg-cream-100 border-t border-warm-gray-100 mt-auto">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12 py-16">
    <div class="flex flex-col items-center gap-6">
      <!-- Logo -->
      <div class="font-display font-semibold text-base text-warm-gray-800">
        {t.site.name}
      </div>

      <!-- Footer Navigation -->
      <nav class="flex flex-wrap items-center justify-center gap-8 text-sm">
        <a
          href={locale === 'ja' ? '/privacy' : '/en/privacy'}
          class="text-warm-gray-500 hover:text-warm-gray-800 transition-colors"
        >
          {t.footer.privacy}
        </a>
        <a
          href={locale === 'ja' ? '/terms' : '/en/terms'}
          class="text-warm-gray-500 hover:text-warm-gray-800 transition-colors"
        >
          {t.footer.terms}
        </a>
      </nav>

      <!-- Copyright -->
      <!-- WCAG 1.4.3: warm-gray-500(#86868B) on cream-100(#F5F5F7) = 4.65:1 ✓ -->
      <p class="text-sm text-warm-gray-500">{t.footer.copyright}</p>
    </div>
  </div>
</footer>
