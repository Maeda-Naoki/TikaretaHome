---
import Ic from './Ic.astro';

interface Props {
  variant?: 'home' | 'record' | 'result' | 'stats' | 'community';
  size?: 'lg' | 'md';
  tilt?: number;
}

const { variant = 'home', size = 'lg', tilt = 0 } = Astro.props;
const frameClass = size === 'lg' ? 'phone' : 'mini-phone';
const screenClass = size === 'lg' ? 'phone-screen' : 'mini-screen';
const styleAttr = tilt ? `transform: rotate(${tilt}deg);` : undefined;

// 01 · Home — 連続記録 (Pen-faithful: 土〜金, 木=今日, 金=未来)
const weekDays: { d: string; done?: boolean; today?: boolean; future?: boolean }[] = [
  { d: '土', done: true },
  { d: '日', done: true },
  { d: '月' },
  { d: '火' },
  { d: '水', done: true },
  { d: '木', today: true },
  { d: '金', future: true },
] as const;

// 20 · Stats — 今週の散歩 km/日 (土を強調)
const statBars: { d: string; v: number; hot?: boolean }[] = [
  { d: '月', v: 3.2 },
  { d: '火', v: 5.4 },
  { d: '水', v: 2.1 },
  { d: '木', v: 7.0 },
  { d: '金', v: 4.3 },
  { d: '土', v: 8.1, hot: true },
  { d: '日', v: 5.2 },
] as const;
const statMax = 8.1;

// Bottom navigation (5 tabs) — matches the v2 app shell
const navItems = [
  {
    id: 'home',
    label: 'ホーム',
    path: '<path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1v-9z"/>',
  },
  {
    id: 'walk',
    label: 'さんぽ',
    path: '<circle cx="6" cy="9" r="1.8"/><circle cx="10" cy="6" r="1.8"/><circle cx="14" cy="6" r="1.8"/><circle cx="18" cy="9" r="1.8"/><path d="M8 16c0-3 2-5 4-5s4 2 4 5c0 2-2 3-4 3s-4-1-4-3z"/>',
  },
  {
    id: 'stats',
    label: '統計',
    path: '<path d="M4 19V8M10 19V4M16 19v-8M22 19h-20"/>',
  },
  {
    id: 'community',
    label: 'コミュニティ',
    path: '<circle cx="9" cy="9" r="3"/><path d="M3 19c0-3 2.7-5 6-5s6 2 6 5"/><circle cx="17" cy="7" r="2"/><path d="M15 14c3 0 5 1.7 6 4"/>',
  },
  {
    id: 'account',
    label: 'アカウント',
    path: '<circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/>',
  },
] as const;

// Which bottom-nav tab is active per screen
const activeTab: Record<string, string> = {
  home: 'home',
  result: 'home',
  stats: 'stats',
  community: 'community',
};
---
<div class={frameClass} style={styleAttr}>
  <div class="phone-notch" aria-hidden="true"></div>
  <div class={screenClass}>
    <div class={`tk-screen tk-${variant}${variant === 'record' ? ' tk-dark' : ''}`}>

      <!-- ===== Status bar ===== -->
      <div class="tk-status">
        <span>9:41</span>
        <span class="tk-status-icons"><Ic name="signal" size={11} /><Ic name="wifi" size={11} /><Ic name="battery-full" size={15} /></span>
      </div>

      {variant === 'home' && (
        <>
          <header class="tk-top">
            <div class="tk-brand">
              <span class="tk-logo" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="#2a1f00"><path d="M12 13.5c-3 0-5.5 2.2-5.5 4.7 0 1.6 1.3 2.8 3 2.8.9 0 1.7-.3 2.5-.6.8.3 1.6.6 2.5.6 1.7 0 3-1.2 3-2.8 0-2.5-2.5-4.7-5.5-4.7zM6.5 11c1.1 0 2-1.3 2-2.8s-.9-2.8-2-2.8-2 1.3-2 2.8.9 2.8 2 2.8zm11 0c1.1 0 2-1.3 2-2.8s-.9-2.8-2-2.8-2 1.3-2 2.8.9 2.8 2 2.8zM9 7c.8 0 1.5-1.1 1.5-2.5S9.8 2 9 2s-1.5 1.1-1.5 2.5S8.2 7 9 7zm6 0c.8 0 1.5-1.1 1.5-2.5S15.8 2 15 2s-1.5 1.1-1.5 2.5S14.2 7 15 7z"/></svg>
              </span>
              <strong>Tikareta</strong>
            </div>
            <div class="tk-top-r">
              <span class="tk-iconbtn"><Ic name="bell" size={15} /><span class="tk-dot"></span></span>
              <span class="tk-dog" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="rgba(255,255,255,0.95)"><ellipse cx="7" cy="9" rx="1.4" ry="1.8"/><ellipse cx="11" cy="6" rx="1.4" ry="1.8"/><ellipse cx="15" cy="6" rx="1.4" ry="1.8"/><ellipse cx="19" cy="9" rx="1.4" ry="1.8"/><path d="M8 17c0-3 2-5 5-5s5 2 5 5c0 2-2 3-5 3s-5-1-5-3z"/></svg>
              </span>
            </div>
          </header>

          <div class="tk-body">
            <button class="tk-hero" type="button">
              <div>
                <span class="tk-hero-kicker">TAP TO START</span>
                <span class="tk-hero-title">さんぽを始める</span>
              </div>
              <span class="tk-hero-circle"><Ic name="footprints" size={20} /></span>
            </button>

            <button class="tk-typecard" type="button">
              <span class="tk-type-emoji"><Ic name="thermometer" size={22} /></span>
              <span class="tk-type-mid">
                <em>愛犬タイプ</em>
                <strong>日陰ハンター型</strong>
              </span>
              <Ic name="chevron-right" size={16} />
            </button>

            <h3 class="tk-h3">連続記録</h3>
            <div class="tk-card">
              <div class="tk-streak-head">
                <span class="tk-streak-num"><Ic name="flame" size={20} /><b>3</b><i>日連続</i></span>
                <span class="tk-mut">今週の記録</span>
              </div>
              <div class="tk-week">
                {weekDays.map((w) => (
                  <span class="tk-wd">
                    <span class={`tk-wd-dot${w.done ? ' done' : ''}${w.today ? ' today' : ''}${w.future ? ' future' : ''}`}>
                      {w.done && <Ic name="check" size={11} />}
                    </span>
                    <em class={w.today ? 'on' : ''}>{w.d}</em>
                  </span>
                ))}
              </div>
            </div>

            <h3 class="tk-h3">今日のサマリー</h3>
            <div class="tk-card">
              <div class="tk-sum">
                <span class="tk-sum-col"><b>1.5<i>km</i></b><em>距離</em></span>
                <span class="tk-vline"></span>
                <span class="tk-sum-col"><b>30<i>分</i></b><em>時間</em></span>
                <span class="tk-vline"></span>
                <span class="tk-sum-col"><b>2<i>回</i></b><em>休憩</em></span>
              </div>
              <div class="tk-divider"></div>
              <p class="tk-sub-label">休憩の理由</p>
              <div class="tk-trend"><span class="l"><Ic name="thermometer" size={13} />暑い</span><span class="t"><i style="width:60%"></i></span><span class="v">1回 · 60%</span></div>
              <div class="tk-trend"><span class="l"><Ic name="flower" size={13} />匂い</span><span class="t"><i style="width:40%"></i></span><span class="v">1回 · 40%</span></div>
            </div>
          </div>
        </>
      )}

      {variant === 'record' && (
        <>
          <header class="tk-top tk-top-dark">
            <span class="tk-iconbtn ghost"><Ic name="menu" size={18} /></span>
            <span class="tk-iconbtn ghost"><Ic name="map-pin" size={16} /></span>
          </header>

          <div class="tk-rec-timer">
            <span class="tk-rec-kicker">経過時間</span>
            <span class="tk-rec-time">12:45</span>
            <div class="tk-rec-stats">
              <span><b>1.24</b><em>km</em></span>
              <span class="tk-vline dark"></span>
              <span><b>1</b><em>休憩</em></span>
              <span class="tk-vline dark"></span>
              <span><b>5.8</b><em>km/h</em></span>
            </div>
          </div>

          <div class="tk-rec-map">
            <svg viewBox="0 0 240 280" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs>
                <pattern id="tk-grid" width="28" height="28" patternUnits="userSpaceOnUse">
                  <path d="M28 0 L0 0 0 28" fill="none" stroke="rgba(255,255,255,.06)" stroke-width="1"/>
                </pattern>
              </defs>
              <rect width="240" height="280" fill="url(#tk-grid)"/>
              <path d="M-10 150 Q60 120 110 160 T260 130" stroke="rgba(255,255,255,.10)" stroke-width="14" fill="none"/>
              <path d="M40 300 C70 220 120 220 120 150 S180 60 210 -10" stroke="var(--app-accent)" stroke-width="3" fill="none" stroke-linecap="round" stroke-dasharray="2 7"/>
            </svg>
            <span class="tk-rec-weather"><Ic name="sun" size={12} />28°C · 渋谷</span>
            <span class="tk-rec-loc" aria-hidden="true"></span>
          </div>

          <div class="tk-rec-actions">
            <button class="tk-hero tk-rec-log" type="button">
              <div>
                <span class="tk-hero-kicker">TAP TO LOG</span>
                <span class="tk-hero-title">いま休憩した</span>
                <span class="tk-hero-note">位置と時刻は自動取得</span>
              </div>
              <span class="tk-hero-circle sq"><Ic name="plus" size={24} /></span>
            </button>
            <button class="tk-rec-stop" type="button">長押しで終了</button>
            <p class="tk-rec-foot">屋外でも見やすいダークUI</p>
          </div>
        </>
      )}

      {variant === 'result' && (
        <>
          <header class="tk-top">
            <span class="tk-iconbtn ghost"><Ic name="chevron-left" size={18} /></span>
            <strong class="tk-top-title">愛犬タイプ診断</strong>
            <span class="tk-iconbtn ghost"><Ic name="share-2" size={16} /></span>
          </header>

          <div class="tk-body">
            <div class="tk-diag-card">
              <span class="tk-diag-glow" aria-hidden="true"></span>
              <span class="tk-diag-emoji"><Ic name="thermometer" size={48} /></span>
              <div class="tk-diag-title">日陰ハンター型</div>
              <p class="tk-diag-desc">気温が高くなると休憩が増える、暑さに敏感なタイプです。木陰やベンチを好んで休憩します。</p>
            </div>

            <div class="tk-card tk-feat">
              <p class="tk-feat-label">特徴</p>
              <ul>
                <li><span>•</span>25℃以上で休憩率が2倍に増加</li>
                <li><span>•</span>日陰のある場所を好んで休憩</li>
                <li><span>•</span>朝の散歩では休憩が少ない傾向</li>
              </ul>
            </div>
          </div>
        </>
      )}

      {variant === 'stats' && (
        <>
          <header class="tk-top">
            <strong class="tk-page-title">統計</strong>
            <span class="tk-iconbtn ghost"><Ic name="share-2" size={16} /></span>
          </header>

          <div class="tk-body">
            <div class="tk-seg">
              <span class="on">週間</span>
              <span>月間<Ic name="lock" size={10} /></span>
              <span>全期間<Ic name="lock" size={10} /></span>
            </div>

            <div class="tk-card tk-stat-hero">
              <div class="tk-stat-hero-top">
                <div>
                  <span class="tk-mut up">今週の散歩</span>
                  <p class="tk-stat-big">5.2<i>km</i></p>
                  <span class="tk-mut">1月8日 〜 14日</span>
                </div>
                <span class="tk-pill-pos"><Ic name="trending-up" size={11} />+12%</span>
              </div>
              <div class="tk-bars">
                {statBars.map((b) => (
                  <span class="tk-bar">
                    <i class={b.hot ? 'hot' : ''} style={`height:${Math.max(8, Math.round((b.v / statMax) * 56))}px`}></i>
                    <em>{b.d}</em>
                  </span>
                ))}
              </div>
            </div>

            <div class="tk-mini-grid">
              <div class="tk-card tk-mini"><span class="r"><Ic name="clock" size={13} /><i class="pos">+3</i></span><b>28<em>分</em></b><span class="tk-mut">平均時間</span></div>
              <div class="tk-card tk-mini"><span class="r"><Ic name="footprints" size={13} /><i class="neg">−2</i></span><b>12<em>回</em></b><span class="tk-mut">休憩数</span></div>
              <div class="tk-card tk-mini"><span class="r"><Ic name="flame" size={13} /><i class="pos">+1</i></span><b>3<em>日</em></b><span class="tk-mut">連続</span></div>
              <div class="tk-card tk-mini"><span class="r"><Ic name="trending-up" size={13} /><i>±0</i></span><b>4.6<em>km/h</em></b><span class="tk-mut">ペース</span></div>
            </div>
          </div>
        </>
      )}

      {variant === 'community' && (
        <>
          <header class="tk-top">
            <strong class="tk-page-title">コミュニティ</strong>
          </header>

          <div class="tk-body">
            <h3 class="tk-h3">今日の休憩トレンド</h3>
            <div class="tk-card tk-trend-card">
              <div class="tk-trow"><span class="l"><Ic name="flame" size={16} />暑い</span><span class="d">↑42%</span></div>
              <div class="tk-divider"></div>
              <div class="tk-trow"><span class="l"><Ic name="moon" size={16} />疲れた</span><span class="d">18%</span></div>
              <div class="tk-divider"></div>
              <div class="tk-trow"><span class="l"><Ic name="flower" size={16} />匂い</span><span class="d">12%</span></div>
            </div>

            <h3 class="tk-h3">タイムライン</h3>
            <div class="tk-card tk-post">
              <div class="tk-post-head">
                <span class="tk-dog sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="rgba(255,255,255,0.95)"><ellipse cx="7" cy="9" rx="1.4" ry="1.8"/><ellipse cx="11" cy="6" rx="1.4" ry="1.8"/><ellipse cx="15" cy="6" rx="1.4" ry="1.8"/><ellipse cx="19" cy="9" rx="1.4" ry="1.8"/><path d="M8 17c0-3 2-5 5-5s5 2 5 5c0 2-2 3-5 3s-5-1-5-3z"/></svg></span>
                <span class="tk-post-id"><b>もも太郎</b><em>柴犬 3歳 · 晴れ 28℃ · 5分前</em></span>
              </div>
              <div class="tk-reacts">
                <span class="r"><Ic name="footprints" size={13} />うちも！<i>12</i></span>
                <span class="r"><Ic name="lightbulb" size={13} /><i>5</i></span>
                <span class="r"><Ic name="dumbbell" size={13} /><i>3</i></span>
                <span class="r"><Ic name="heart" size={13} /><i>8</i></span>
              </div>
            </div>
            <div class="tk-card tk-post">
              <div class="tk-post-head">
                <span class="tk-dog sm" aria-hidden="true"><svg viewBox="0 0 24 24" fill="rgba(255,255,255,0.95)"><ellipse cx="7" cy="9" rx="1.4" ry="1.8"/><ellipse cx="11" cy="6" rx="1.4" ry="1.8"/><ellipse cx="15" cy="6" rx="1.4" ry="1.8"/><ellipse cx="19" cy="9" rx="1.4" ry="1.8"/><path d="M8 17c0-3 2-5 5-5s5 2 5 5c0 2-2 3-5 3s-5-1-5-3z"/></svg></span>
                <span class="tk-post-id"><b>まる子ママ</b><em>トイプードル 5歳 · 曇り 22℃ · 15分前</em></span>
              </div>
              <div class="tk-reacts">
                <span class="r"><Ic name="footprints" size={13} />うちも！<i>24</i></span>
                <span class="r"><Ic name="lightbulb" size={13} /><i>8</i></span>
                <span class="r"><Ic name="dumbbell" size={13} /><i>15</i></span>
              </div>
            </div>
          </div>
        </>
      )}

      {activeTab[variant] && (
        <nav class="tk-nav" aria-hidden="true">
          {navItems.map((it) => (
            <span class={`tk-tab${activeTab[variant] === it.id ? ' active' : ''}`}>
              <svg class="tk-nav-svg" viewBox="0 0 24 24" set:html={it.path} />
              <em>{it.label}</em>
            </span>
          ))}
        </nav>
      )}

    </div>
  </div>
</div>

<style>
  /* ===========================================================
     Tikareta v2 app screens — faithful in-phone reproductions.
     Local theme tokens mirror the app (amber/gold), independent
     of the landing page's orange palette so the mockups read as
     real app screenshots.
     =========================================================== */
  .tk-screen {
    --app-accent: #faaa00;
    --app-accent-soft: #fee59a;
    --app-accent-strong: #a36a10;
    --app-page: #f5f4f1;
    --app-card: #ffffff;
    --app-muted: #f0efec;
    --app-line: #e5e3df;
    --app-ink: #1a1a1a;
    --app-ink-2: #6b6b6b;
    --app-ink-3: #8a857c;
    --app-pos: #2e7d32;
    --app-neg: #c62828;

    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--app-page);
    color: var(--app-ink);
    font-size: 11px;
    line-height: 1.4;
    overflow: hidden;
  }
  .tk-screen.tk-dark {
    background: #1a1816;
    color: #fff5d6;
  }

  .tk-screen :global(.ic) {
    stroke-width: 2;
    flex-shrink: 0;
  }

  /* ----- Status bar ----- */
  .tk-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.9rem 0.15rem;
    font-size: 0.62rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .tk-status-icons {
    display: flex;
    gap: 0.18rem;
    align-items: center;
  }
  .tk-dark .tk-status {
    color: #fff;
  }

  /* ----- Top bar ----- */
  .tk-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.85rem 0.4rem;
    flex-shrink: 0;
  }
  .tk-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tk-brand strong {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .tk-logo {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: linear-gradient(135deg, #ffd66b 0%, #faaa00 50%, #d88c00 100%);
    display: grid;
    place-items: center;
    box-shadow: 0 2px 8px rgba(250, 170, 0, 0.3);
  }
  .tk-logo svg {
    width: 15px;
    height: 15px;
  }
  .tk-top-r {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tk-top-title {
    font-size: 0.78rem;
    font-weight: 600;
  }
  .tk-page-title {
    font-size: 1rem;
    font-weight: 700;
  }
  .tk-iconbtn {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--app-ink-2);
  }
  .tk-iconbtn.ghost {
    color: var(--app-ink);
  }
  .tk-top-dark .tk-iconbtn {
    color: rgba(255, 245, 214, 0.7);
  }
  .tk-dot {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f37535;
    border: 1.5px solid #fff;
  }
  .tk-dog {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f3d795 0%, #e0a86b 50%, #b87333 100%);
    display: grid;
    place-items: center;
    box-shadow: inset 0 -2px 6px rgba(0, 0, 0, 0.1);
  }
  .tk-dog svg {
    width: 16px;
    height: 16px;
  }
  .tk-dog.sm {
    width: 28px;
    height: 28px;
  }
  .tk-dog.sm svg {
    width: 15px;
    height: 15px;
  }

  /* ----- Scroll body ----- */
  .tk-body {
    flex: 1;
    overflow: hidden;
    padding: 0.3rem 0.9rem 0.6rem;
    display: flex;
    flex-direction: column;
  }

  /* ----- Section heading ----- */
  .tk-h3 {
    font-size: 0.8rem;
    font-weight: 700;
    margin: 0.85rem 0 0.4rem;
  }
  .tk-mut {
    color: var(--app-ink-3);
    font-size: 0.62rem;
  }
  .tk-mut.up {
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ----- Card ----- */
  .tk-card {
    background: var(--app-card);
    border: 1px solid var(--app-line);
    border-radius: 14px;
    padding: 0.7rem;
  }
  .tk-divider {
    height: 1px;
    background: var(--app-line);
    margin: 0.55rem 0;
  }
  .tk-vline {
    width: 1px;
    align-self: stretch;
    background: var(--app-line);
  }
  .tk-vline.dark {
    background: rgba(255, 255, 255, 0.12);
  }

  /* ----- Golden-retriever hero button ----- */
  .tk-hero {
    width: 100%;
    margin-top: 0.4rem;
    padding: 0.75rem 0.85rem;
    border-radius: 18px;
    background: linear-gradient(160deg, #f3ce7e 0%, #d9a84e 100%);
    border: 1px solid #a8762a;
    color: #382a1a;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
    box-shadow: 0 8px 22px rgba(168, 118, 42, 0.28);
  }
  .tk-hero-kicker {
    display: block;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    opacity: 0.85;
  }
  .tk-hero-title {
    display: block;
