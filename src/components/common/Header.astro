---
import { useTranslations } from '@utils/i18n';
import Ic from './Ic.astro';
import LogoMark from './LogoMark.astro';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);
const homeUrl = locale === 'ja' ? '/' : '/en/';

const navLinks = [
  { href: '#how', label: t.nav.howItWorks },
  { href: '#types', label: t.nav.typeDiagnosis },
  { href: '#features', label: t.nav.features },
  { href: '#pricing', label: t.nav.pricing },
  { href: '#faq', label: t.nav.faq },
];

const jaUrl = Astro.url.pathname.replace(/^\/en\//, '/') || '/';
const enUrl = `/en${Astro.url.pathname.replace(/^\/en/, '')}`;
const isEn = locale === 'en';
---

<header class="nav-sticky">
  <div class="container-page nav-inner">
    <a href={homeUrl} class="logo-link">
      <LogoMark />
      <span>Tikareta</span>
    </a>

    <nav class="nav-links" aria-label={t.nav.mainLabel}>
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav-right">
      <div class="lang-switch" role="group" aria-label={t.common.language}>
        <button class={!isEn ? 'active' : ''} type="button" onclick={`location.href='${jaUrl}'`}>日本語</button>
        <button class={isEn ? 'active' : ''} type="button" onclick={`location.href='${enUrl}'`}>EN</button>
      </div>
      <a class="btn btn-ghost nav-login" href="#">{t.nav.login}</a>
      <a class="btn btn-primary" href="#cta">
        <Ic name="arrow-right" size={16} />{t.nav.startFree}
      </a>
    </div>

    <button id="mobile-menu-btn" class="mobile-toggle" aria-label={t.common.menu} aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden>
    <nav>
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="mobile-footer">
      <a class="btn btn-primary" href="#cta" style="justify-content:center; width:100%;">{t.nav.startFree}</a>
    </div>
  </div>
</header>

<style>
  .nav-inner {
    display: flex; align-items: center; justify-content: space-between;
    height: 4.25rem;
  }
  .logo-link {
    display: flex; align-items: center; gap: .55rem;
    font-weight: 800; font-size: 1.1rem; letter-spacing: -.01em;
  }
  .nav-links { display: none; gap: 2rem; align-items: center; }
  .nav-links a {
    font-size: .9rem; color: var(--ink-soft); font-weight: 500; transition: color .15s;
  }
  .nav-links a:hover { color: var(--ink); }
  .nav-right { display: flex; gap: .75rem; align-items: center; }
  .nav-login { display: none; }
  .nav-right .btn-primary { display: none; }
  .mobile-toggle {
    display: flex; align-items: center; justify-content: center;
    color: var(--ink-soft); padding: .4rem;
  }
  @media (min-width: 540px) {
    .nav-right .btn-primary { display: inline-flex; }
  }
  @media (min-width: 880px) {
    .nav-links { display: flex; }
    .nav-login { display: inline-flex; }
    .mobile-toggle { display: none; }
  }

  .mobile-menu {
    border-top: 1px solid var(--line);
    padding: 1rem var(--gutter) 1.25rem;
    background: color-mix(in oklab, var(--bg) 95%, transparent);
    backdrop-filter: blur(14px);
  }
  .mobile-menu nav { display: flex; flex-direction: column; gap: .15rem; margin-bottom: 1rem; }
  .mobile-menu nav a {
    padding: .75rem .5rem; font-weight: 500;
    color: var(--ink-soft); font-size: .95rem;
    border-bottom: 1px solid var(--line-soft);
    display: block;
  }
  .mobile-menu nav a:hover { color: var(--ink); }
  .mobile-footer { padding-top: .75rem; }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.hidden === false;
      menu.hidden = open;
      btn.setAttribute('aria-expanded', String(!open));
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') {
        menu.hidden = true;
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
