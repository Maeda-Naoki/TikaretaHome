---
import { ICONS, type IconName } from '@data/icons';
import {
  ChartColumn,
  Cloud,
  CloudSun,
  Compass,
  Dog,
  Flame,
  Footprints,
  Heart,
  Hospital,
  Image,
  Map as MapIcon,
  MapPin,
  MessageCircle,
  Moon,
  Save,
  Search,
  Sparkles,
  Sunrise,
  Target,
  TreePine,
  TrendingUp,
  Zap,
} from '@lucide/astro';

interface Props {
  name: string;
  type?: 'lucide' | 'emoji' | 'svg';
  size?: number;
  class?: string;
}

const { name, type = 'lucide', size = 24, class: className = '' } = Astro.props;

const lucideMap: Record<string, typeof TreePine> = {
  TreePine,
  Compass,
  Sunrise,
  Zap,
  Footprints,
  Moon,
  Cloud,
  MapPin,
  Image,
  CloudSun,
  // content/data 側は 'BarChart3' 名で参照しているためキー名は維持
  BarChart3: ChartColumn,
  TrendingUp,
  Dog,
  MessageCircle,
  Target,
  Map: MapIcon,
  Flame,
  Save,
  Hospital,
  Sparkles,
  Search,
  Heart,
};

const svgInner = ICONS[name as IconName];
const LucideIcon = lucideMap[name];
const sizeStyle = `width:${size}px;height:${size}px;`;
---

{type === 'svg' && svgInner ? (
  <svg
    class={`ic ${className}`}
    viewBox="0 0 24 24"
    aria-hidden="true"
    style={sizeStyle}
    set:html={svgInner}
  />
) : type === 'lucide' && LucideIcon ? (
  <LucideIcon size={size} class={className} />
) : (
  <span class={className} style={`font-size: ${size}px`}>{name}</span>
)}
