---
import Ic from '@components/common/Ic.astro';
import { useTranslations } from '@utils/i18n';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);

const emojis = ['🌳', '🧭', '🌅', '⚡', '🐾', '🛤️', '🌙', '☔'];
const typeKeys = [
  'shadeHunter',
  'explorer',
  'morningEnjoyer',
  'shortBurst',
  'socialButterfly',
  'steadyWalker',
  'nightOwl',
  'weatherFlexible',
] as const;

const dogTypes = typeKeys.map((key, i) => ({
  emoji: emojis[i],
  name: t.walkingTypes[key].name,
  body: t.walkingTypes[key].description,
}));
---
<section id="types" class="section-pad" style="background:var(--bg);">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">Walking Types</span>
      <h2>{t.typeDiagnosis.title}</h2>
      <p>{t.typeDiagnosis.subtitle}</p>
    </div>

    <div class="types-grid">
      {dogTypes.map((d, i) => (
        <article class="type-card reveal" style={`transition-delay:${i * 60}ms;`}>
          <span class="arrow"><Ic name="arrow-up-right" size={14} /></span>
          <div class="type-emoji">{d.emoji}</div>
          <h3 style="font-size:1rem; margin-bottom:.35rem;">{d.name}</h3>
          <p style="font-size:.82rem; color:var(--ink-soft); line-height:1.55;">{d.body}</p>
        </article>
      ))}
    </div>

    <div style="text-align:center; margin-top:3rem;">
      <a class="btn btn-soft" href="https://tikareta.com" target="_blank" rel="noopener">
        <Ic name="sparkles" size={16} />{t.typeDiagnosis.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .types-grid {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem;
  }
  @media (min-width: 640px)  { .types-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .types-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
