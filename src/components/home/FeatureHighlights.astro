---
import Ic from '@components/common/Ic.astro';
import type { IconName } from '@data/icons';
import { useTranslations } from '@utils/i18n';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);

type FeatureTier = 'free' | 'standard' | 'pro';
type FeatureKey = keyof typeof t.features;

const tierLabel: Record<FeatureTier, string> = { free: 'FREE', standard: 'STANDARD', pro: 'PRO' };

const ITEMS: Array<{ key: FeatureKey; tier: FeatureTier; icon: IconName }> = [
  { key: 'walkTracking', tier: 'free', icon: 'footprints' },
  { key: 'restSpots', tier: 'free', icon: 'map-pin' },
  { key: 'weatherTracking', tier: 'free', icon: 'cloud-sun' },
  { key: 'allDataAccess', tier: 'free', icon: 'history' },
  { key: 'basicType', tier: 'free', icon: 'target' },
  { key: 'community', tier: 'free', icon: 'users' },
  { key: 'fullStats', tier: 'standard', icon: 'bar-chart-3' },
  { key: 'detailedType', tier: 'standard', icon: 'sparkles' },
  { key: 'customShare', tier: 'standard', icon: 'share-2' },
  { key: 'routeSuggestion', tier: 'pro', icon: 'route' },
  { key: 'heatmap', tier: 'pro', icon: 'flame' },
  { key: 'trendAnalysis', tier: 'pro', icon: 'trending-up' },
];
---
<section id="features" class="section-pad" style="background:var(--bg);">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">Features</span>
      <h2>{t.featureHighlights.title}</h2>
      <p>{t.featureHighlights.subtitle}</p>
    </div>

    <div class="feat-grid">
      {ITEMS.map((f, i) => (
        <article class={`feat ${f.tier} reveal`} style={`transition-delay:${i * 60}ms;`}>
          <span class="tag">{tierLabel[f.tier]}</span>
          <div class="ico"><Ic name={f.icon} size={20} /></div>
          <h3 style="font-size:1.05rem; margin-bottom:.35rem;">{t.features[f.key].title}</h3>
          <p style="font-size:.9rem; color:var(--ink-soft); line-height:1.55;">{t.features[f.key].description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feat-grid {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem;
  }
  @media (min-width: 640px)  { .feat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .feat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
