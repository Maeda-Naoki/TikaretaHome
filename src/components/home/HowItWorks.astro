---
import Ic from '@components/common/Ic.astro';
import { steps } from '@data/content';
---
<section id="how" class="section-pad" style="background: linear-gradient(180deg, transparent, var(--surface-2));">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">How it works</span>
      <h2>はじめかたは、<br />とってもかんたん。</h2>
      <p>3ステップで、愛犬の「おさんぽタイプ」が見えてきます。</p>
    </div>

    <div class="how-grid">
      {steps.map((s, i) => (
        <article class="card-base reveal" style={`transition-delay:${i * 100}ms;`}>
          <span class="step-num">{s.num}</span>
          <h3 style="font-size:1.2rem; margin-bottom:.65rem;">{s.title}</h3>
          <p style="color:var(--ink-soft); font-size:.92rem; line-height:1.7;">{s.body}</p>
          <div class="step-art"><Ic name={s.icon} size={42} /></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .how-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  @media (min-width: 820px) { .how-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
