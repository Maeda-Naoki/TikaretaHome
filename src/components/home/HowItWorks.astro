---
import { useTranslations } from '@utils/i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="py-24 md:py-32 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-display font-bold text-warm-gray-900 tracking-tight text-center mb-16 fade-in-up">
      {t.howItWorks.title}
    </h2>
    <div class="grid md:grid-cols-3 gap-12 md:gap-8">
      {t.howItWorks.steps.map((step, index) => (
        <div
          class="relative fade-in-up"
          style={`animation-delay: ${index * 150}ms`}
        >
          <div class="flex flex-col items-center text-center">
            <!-- WCAG 1.4.3: primary-700(#c2410c) border + text on white = 4.79:1 ✓ -->
            <div class="w-12 h-12 rounded-full border-2 border-primary-700 text-primary-700 flex items-center justify-center text-xl font-bold mb-5">
              {step.number}
            </div>
            <h3 class="text-xl font-semibold text-warm-gray-900 mb-3">{step.title}</h3>
            <p class="text-warm-gray-600 leading-relaxed">{step.description}</p>
          </div>
          {index < 2 && (
            /* WCAG 1.1.1: 装飾的な矢印を支援技術から隠す */
            <div class="hidden md:block absolute top-5 -right-6 text-warm-gray-300 text-2xl" aria-hidden="true">
              →
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
