---
const logos = ['DOG LIFE', 'pawmag', 'INU+', '柴犬タイムズ', 'TAIL.', 'Wan! Style'];
---
<section class="trust-strip">
  <div class="container-page" style="text-align:center;">
    <p class="trust-label">
      全国 <strong>3,200名</strong> の飼い主さんと、その子たちが愛用中
    </p>
    <ul class="trust-row" aria-label="掲載・取材実績">
      {logos.map((l) => <li>{l}</li>)}
    </ul>
  </div>
</section>

<style>
  .trust-label {
    font-size: .82rem; color: var(--ink-mute); margin-bottom: 1.5rem;
  }
  .trust-label strong {
    color: var(--ink); font-family: var(--font-mono); font-weight: 700; margin: 0 .15rem;
  }
  .trust-row {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap;
    justify-content: center; align-items: center;
    gap: 2rem 2.5rem; opacity: .7;
  }
  .trust-row li {
    font-family: var(--font-display); font-weight: 800;
    letter-spacing: .04em; font-size: 1rem; color: var(--w600);
  }
</style>
