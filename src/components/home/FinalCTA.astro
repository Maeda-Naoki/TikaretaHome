---
import CTAButton from '@components/common/CTAButton.astro';
import { useTranslations } from '@utils/i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="py-32 md:py-40 px-6 bg-cream-100">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-4xl md:text-5xl font-display font-bold text-warm-gray-900 tracking-tight mb-6 fade-in-up">
      {t.finalCTA.title}
    </h2>
    <p class="text-xl text-warm-gray-600 leading-relaxed mb-12 fade-in-up">
      {t.finalCTA.subtitle}
    </p>
    <div class="fade-in-up">
      <CTAButton text={t.finalCTA.cta} size="lg" />
    </div>
  </div>
</section>
