---
import Ic from '@components/common/Ic.astro';
import { APP_COMING_SOON, welcomeUrl } from '@data/navigation';
import { useTranslations } from '@utils/i18n';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);
---
<section id="cta" class="final-cta-bg section-pad">
  <div class="container-narrow">
    <div class="final-cta-card">
      <div class="deco-ring"></div>
      <div class="deco-ring r2"></div>
      <h2>{t.finalCTA.title}</h2>
      <p>{t.finalCTA.subtitle}</p>
      <div style="display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap;">
        {APP_COMING_SOON ? (
          <span class="btn btn-primary" style="cursor:default; opacity:.6; pointer-events:none;">
            <Ic name="footprints" size={18} />{t.common.comingSoon}
          </span>
        ) : (
          <a class="btn btn-primary" href={welcomeUrl} target="_blank" rel="noopener noreferrer">
            <Ic name="footprints" size={18} />{t.finalCTA.cta}
          </a>
        )}
        <a class="btn" href="#pricing" style="background:rgba(255,255,255,.12); color:white; border:1px solid rgba(255,255,255,.2);">
          {t.finalCTA.seePricing}
        </a>
      </div>
      <p style="font-size:.82rem; color:rgba(255,255,255,.5); margin-top:1.5rem;">
        {t.finalCTA.meta}
      </p>
    </div>
  </div>
</section>
