---
import Ic from '@components/common/Ic.astro';
import { valueItems } from '@data/content';
---
<section id="value" class="section-pad">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">Why Tikareta</span>
      <h2>毎日のおさんぽが、<br />愛犬を理解するいちばんのデータになる。</h2>
      <p>センサーも特別な機材もいりません。スマホひとつ、片手間で記録するだけ。</p>
    </div>

    <div class="value-grid">
      {valueItems.map((c, i) => (
        <article class="card-base reveal" style={`transition-delay:${i * 80}ms;`}>
          <span class="num-bg">{c.num}</span>
          <span class="icon-wrap"><Ic name={c.icon} size={22} /></span>
          <h3 style="font-size:1.25rem; margin-bottom:.65rem;">{c.title}</h3>
          <p style="color:var(--ink-soft); font-size:.92rem; line-height:1.7;">{c.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .value-grid {
    display: grid; grid-template-columns: 1fr; gap: 1.5rem;
  }
  @media (min-width: 720px) { .value-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
