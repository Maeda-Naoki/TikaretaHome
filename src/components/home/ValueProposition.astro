---
import Icon from '@components/common/Icon.astro';
import { useTranslations } from '@utils/i18n';

const t = useTranslations(Astro.currentLocale);
---

<section class="py-16 md:py-24 px-4 bg-white wave-divider">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-display font-bold text-warm-gray-900 md:text-left text-center mb-4 fade-in-up">
      {t.valueProposition.title}
    </h2>
    <div class="w-16 h-1 bg-primary-400 rounded-full mb-12 md:mx-0 mx-auto fade-in-up"></div>

    <!-- 非対称グリッド: 1つ目を大きく、2-3を小さくスタック -->
    <div class="grid md:grid-cols-[1.2fr_1fr] gap-6 md:gap-8">
      {t.valueProposition.items.map((item, index) => {
        if (index === 0) {
          return (
            <div
              class="p-8 bg-cream-50 rounded-card border border-warm-gray-100 hover:shadow-card transition-all slide-in-left"
              style="transition-delay: 0ms"
            >
              <div class="mb-5 w-14 h-14 bg-primary-100 rounded-soft flex items-center justify-center">
                <Icon name={item.icon} type={item.iconType as 'lucide' | 'emoji'} size={32} class="text-primary-700" />
              </div>
              <h3 class="text-2xl font-bold text-warm-gray-900 mb-3">{item.title}</h3>
              <p class="text-warm-gray-600 text-lg leading-relaxed">{item.description}</p>
            </div>
          );
        }
        return null;
      })}
      <div class="flex flex-col gap-6">
        {t.valueProposition.items.map((item, index) => {
          if (index === 0) return null;
          return (
            <div
              class="p-6 bg-cream-50 rounded-card border border-warm-gray-100 hover:shadow-card transition-all flex items-start gap-5 slide-in-right"
              style={`transition-delay: ${index * 120}ms`}
            >
              <div class="w-12 h-12 bg-primary-100 rounded-soft flex items-center justify-center flex-shrink-0">
                <Icon name={item.icon} type={item.iconType as 'lucide' | 'emoji'} size={28} class="text-primary-700" />
              </div>
              <div>
                <h3 class="text-lg font-bold text-warm-gray-900 mb-2">{item.title}</h3>
                <p class="text-warm-gray-600">{item.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
