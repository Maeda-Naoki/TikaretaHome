---
import PhoneMock from '@components/common/PhoneMock.astro';
import { useTranslations } from '@utils/i18n';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);

const variants = ['home', 'record', 'result', 'stats', 'community'] as const;
const screens = variants.map((variant, i) => ({
  variant,
  label: t.showcase.screens[i],
}));
---
<section class="section-pad" style="background:var(--surface-2); overflow:hidden;" id="showcase">
  <div class="section-head reveal" style="max-width:45rem; margin:0 auto 0; padding:0 var(--gutter);">
    <span class="eyebrow">App Screens</span>
    <h2>{t.showcase.title}</h2>
    <p>{t.showcase.subtitle}</p>
  </div>

  <div class="showcase-track">
    <div class="showcase-spacer"></div>
    {screens.map((s) => (
      <div class="showcase-slot">
        <div class="slot-label">
          <span class="dot"></span>
          {s.label}
        </div>
        <PhoneMock variant={s.variant} size="md" />
      </div>
    ))}
    <div class="showcase-spacer"></div>
  </div>
</section>

<style>
  .slot-label {
    display: flex; align-items: center; gap: .5rem;
    font-family: var(--font-mono); font-size: .72rem;
    color: var(--ink-soft); letter-spacing: .12em; text-transform: uppercase;
  }
  .slot-label .dot {
    width: 0.375rem; height: 0.375rem; border-radius: 50%; background: var(--accent);
  }

  .showcase-track { padding-bottom: 3rem; }
</style>
