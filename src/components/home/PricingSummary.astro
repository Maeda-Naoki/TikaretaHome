---
import Ic from '@components/common/Ic.astro';
import { useTranslations } from '@utils/i18n';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);

type PlanId = 'free' | 'monthly' | 'yearly';
type CtaStyle = 'btn-primary' | 'btn-ghost' | 'btn-soft';

interface PlanFeatureRow {
  text: string;
  on: boolean;
  emphasized?: boolean;
}

interface Plan {
  id: PlanId;
  name: string;
  tagline: string;
  monthly: number;
  yearly: number;
  features: PlanFeatureRow[];
  ctaLabel: string;
  ctaStyle: CtaStyle;
  featured: boolean;
}

const plans: Plan[] = [
  {
    id: 'free',
    name: t.pricing.plans.free.name,
    tagline: t.pricing.plans.free.tagline,
    monthly: 0,
    yearly: 0,
    features: [
      { text: t.pricing.plans.free.features.walkTracking, on: true },
      { text: t.pricing.plans.free.features.restSpots, on: true },
      { text: t.pricing.plans.free.features.weatherTracking, on: true },
      { text: t.pricing.plans.free.features.allDataAccess, on: true },
      { text: t.pricing.plans.free.features.basicStats, on: true },
      { text: t.pricing.plans.free.features.basicType, on: true },
      { text: t.pricing.plans.free.features.community, on: true },
      { text: t.pricing.plans.monthly.features.fullStats, on: false },
      { text: t.pricing.plans.monthly.features.detailedType, on: false },
    ],
    ctaLabel: t.pricing.plans.free.cta,
    ctaStyle: 'btn-ghost',
    featured: false,
  },
  {
    id: 'monthly',
    name: t.pricing.plans.monthly.name,
    tagline: t.pricing.plans.monthly.tagline,
    monthly: 300,
    yearly: 2400,
    features: [
      { text: t.pricing.plans.monthly.features.allFree, on: true, emphasized: true },
      { text: t.pricing.plans.monthly.features.fullStats, on: true },
      { text: t.pricing.plans.monthly.features.detailedType, on: true },
      { text: t.pricing.plans.monthly.features.breedComparison, on: true },
      { text: t.pricing.plans.monthly.features.routeSuggestion, on: true },
      { text: t.pricing.plans.monthly.features.heatmap, on: true },
      { text: t.pricing.plans.monthly.features.dataExport, on: true },
      { text: t.pricing.plans.monthly.features.customShare, on: true },
    ],
    ctaLabel: t.pricing.plans.monthly.cta,
    ctaStyle: 'btn-primary',
    featured: true,
  },
  {
    id: 'yearly',
    name: t.pricing.plans.yearly.name,
    tagline: t.pricing.plans.yearly.tagline,
    monthly: 200,
    yearly: 2400,
    features: [
      { text: t.pricing.plans.yearly.features.allFree, on: true, emphasized: true },
      { text: t.pricing.plans.yearly.features.fullStats, on: true },
      { text: t.pricing.plans.yearly.features.detailedType, on: true },
      { text: t.pricing.plans.yearly.features.breedComparison, on: true },
      { text: t.pricing.plans.yearly.features.routeSuggestion, on: true },
      { text: t.pricing.plans.yearly.features.heatmap, on: true },
      { text: t.pricing.plans.yearly.features.dataExport, on: true },
      { text: t.pricing.plans.yearly.features.customShare, on: true },
    ],
    ctaLabel: t.pricing.plans.yearly.cta,
    ctaStyle: 'btn-soft',
    featured: false,
  },
];
---
<section id="pricing" class="section-pad" style="background:var(--surface-2);">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">Pricing</span>
      <h2>{t.pricingSummary.title}</h2>
      <p>{t.pricingSummary.subtitle}</p>
    </div>

    <div class="plans-grid">
      {plans.map((plan) => (
        <div class={`plan plan-${plan.id} reveal ${plan.featured ? 'featured' : ''}`}>
          {plan.featured && <span class="badge">{t.pricing.recommended}</span>}
          <div>
            <p class="plan-name">{plan.name}</p>
            <p class="plan-tagline">{plan.tagline}</p>
          </div>
          <div class="plan-price">
            {plan.monthly === 0 ? (
              <>
                <span class="amount">0</span>
                <span class="currency">{locale === 'en' ? 'Free' : '円'}</span>
              </>
            ) : (
              <>
                <span class="currency">¥</span>
                <span class="amount">{plan.monthly}</span>
                <span class="period">{t.pricing.perMonth}</span>
              </>
            )}
          </div>
          {plan.id === 'yearly' && (
            <p class="plan-yearly-note">¥{plan.yearly}{t.pricing.perYear} — {t.pricingSummary.savingsTag}</p>
          )}
          <ul>
            {plan.features.map((f) => (
              <li class={!f.on ? 'muted' : ''}>
                <Ic name={f.on ? 'check' : 'minus'} size={14} />
                <span style={f.emphasized ? 'font-weight:600; color:var(--ink);' : ''}>{f.text}</span>
              </li>
            ))}
          </ul>
          <a class={`btn ${plan.ctaStyle}`} href="https://tikareta.com" target="_blank" rel="noopener">
            {plan.ctaLabel}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .plans-grid {
    display: grid; grid-template-columns: 1fr; gap: 1.25rem;
    max-width: 1100px; margin: 0 auto; align-items: start;
  }
  @media (min-width: 640px) { .plans-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
