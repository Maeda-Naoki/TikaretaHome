---
import { pricingPlans } from '@data/pricing';
import { useTranslations } from '@utils/i18n';

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'ja';
const pricingUrl = locale === 'ja' ? '/pricing' : '/en/pricing';

// WCAG 1.1.1: チェックマークのスクリーンリーダー用テキスト
const srYes = locale === 'ja' ? '○' : 'Yes';
---

<section class="py-24 md:py-32 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 fade-in-up">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-warm-gray-900 tracking-tight mb-4">
        {t.pricingSummary.title}
      </h2>
      <p class="text-xl text-warm-gray-600 leading-relaxed">{t.pricingSummary.subtitle}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 md:gap-8 mb-12">
      {pricingPlans.map((plan, index) => (
        <div
          class={`p-8 md:p-10 rounded-card border transition-all fade-in-up ${
            plan.recommended
              ? 'bg-white border-2 border-primary-700 shadow-card'
              : 'bg-cream-100 border-warm-gray-100'
          }`}
          style={`animation-delay: ${index * 100}ms`}
        >
          {plan.recommended && (
            <!-- WCAG 1.4.3: primary-700(#c2410c)+white = 4.79:1 ✓ -->
            <div class="inline-block px-3 py-1 bg-primary-700 text-white text-xs font-semibold rounded-soft mb-4 tracking-wide uppercase">
              {t.pricing.recommended}
            </div>
          )}
          <h3 class="text-2xl font-semibold text-warm-gray-900 mb-4">
            {t.pricing.plans[plan.id].name}
          </h3>
          <div class="mb-6">
            <span class="text-5xl font-bold text-warm-gray-900 tracking-tight">
              ¥{plan.price.toLocaleString()}
            </span>
            {plan.period && (
              <span class="text-warm-gray-500 ml-1">
                {plan.period === 'month' ? t.pricing.perMonth : t.pricing.perYear}
              </span>
            )}
          </div>
          {plan.savings && (
            <!-- WCAG 1.4.3: secondary-700(#15803d) on white/cream = 5.1:1 ✓ -->
            <div class="mb-4 text-secondary-700 font-medium text-sm">
              {t.pricing.savings}
            </div>
          )}
          <ul class="space-y-3 mb-6">
            {Object.values(t.pricing.plans[plan.id].features).slice(0, 3).map((feature) => (
              <li class="flex items-start gap-3 text-sm text-warm-gray-700">
                {/* WCAG 1.1.1: 情報SVGに代替テキスト */}
                <span class="sr-only">{srYes}</span>
                <svg class="w-4 h-4 text-secondary-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="text-center fade-in-up">
      <a
        href={pricingUrl}
        class="inline-block text-primary-700 hover:text-primary-800 font-medium text-sm transition-colors"
      >
        {t.pricingSummary.cta} →
      </a>
    </div>
  </div>
</section>
