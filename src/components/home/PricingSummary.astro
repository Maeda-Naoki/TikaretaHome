---
import Ic from '@components/common/Ic.astro';
import { plans } from '@data/pricing';
import { useTranslations } from '@utils/i18n';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);

type FeatureMap = Record<string, string>;
---
<section id="pricing" class="section-pad" style="background:var(--surface-2);">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">Pricing</span>
      <h2>{t.pricingSummary.title}</h2>
      <p>{t.pricingSummary.subtitle}</p>
    </div>

    <div class="billing-toggle reveal" role="tablist" aria-label="billing">
      <button class="toggle-btn active" type="button" data-billing-toggle="monthly" aria-pressed="true">
        {t.pricingSummary.billingMonthly}
      </button>
      <button class="toggle-btn" type="button" data-billing-toggle="yearly" aria-pressed="false">
        {t.pricingSummary.billingYearly}
        <span class="save-tag">{t.pricingSummary.savingsTag}</span>
      </button>
    </div>

    <div class="plans-grid" data-billing="monthly">
      {plans.map((plan) => {
        const planTexts = t.pricing.plans[plan.key];
        const featureMap = planTexts.features as FeatureMap;
        const yearlyPerMonth = plan.yearly > 0 ? Math.round(plan.yearly / 12) : 0;
        const isFree = plan.monthly === 0 && plan.yearly === 0;
        return (
          <div class={`plan plan-${plan.key} reveal ${plan.featured ? 'featured' : ''}`}>
            {plan.featured && <span class="badge">{t.pricing.recommended}</span>}
            <div>
              <p class="plan-name">{planTexts.name}</p>
              <p class="plan-tagline">{planTexts.tagline}</p>
            </div>
            <div class="plan-price">
              {isFree ? (
                <span class="amount free-amount">{t.pricing.freeLabel}</span>
              ) : (
                <>
                  <span class="billing-monthly">
                    <span class="currency">¥</span>
                    <span class="amount">{plan.monthly.toLocaleString()}</span>
                    <span class="period">{t.pricing.perMonth}</span>
                  </span>
                  <span class="billing-yearly">
                    <span class="currency">¥</span>
                    <span class="amount">{yearlyPerMonth.toLocaleString()}</span>
                    <span class="period">{t.pricing.perMonth}</span>
                  </span>
                </>
              )}
            </div>
            {!isFree && (
              <p class="plan-yearly-note billing-yearly">
                ¥{plan.yearly.toLocaleString()}{t.pricing.perYear} — {t.pricingSummary.savingsTag}
              </p>
            )}
            <ul>
              {plan.featureKeys.map((f) => (
                <li>
                  <Ic name="check" size={14} />
                  <span style={f.emphasized ? 'font-weight:600; color:var(--ink);' : ''}>{featureMap[f.key]}</span>
                </li>
              ))}
            </ul>
            <a class={`btn ${plan.ctaStyle}`} href="https://tikareta.com" target="_blank" rel="noopener">
              {planTexts.cta}
            </a>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .billing-toggle {
    display: flex; justify-content: center; gap: .5rem;
    margin-bottom: 2rem;
  }
  .toggle-btn {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .5rem 1.1rem; border-radius: var(--r-pill);
    border: 1px solid var(--line); background: transparent;
    font-size: .88rem; font-weight: 500; color: var(--ink-soft);
    cursor: pointer; transition: background .15s, color .15s, border-color .15s;
  }
  .toggle-btn.active {
    background: var(--ink); color: var(--bg); border-color: var(--ink);
  }
  .save-tag {
    padding: .15rem .5rem; border-radius: var(--r-pill);
    background: var(--s100); color: var(--s700);
    font-size: .73rem; font-weight: 600;
  }
  .toggle-btn.active .save-tag {
    background: var(--s500); color: #fff;
  }

  .plans-grid {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem;
    max-width: 1100px; margin: 0 auto; align-items: start;
  }
  @media (min-width: 640px) { .plans-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .free-amount { font-size: 2rem; font-weight: 800; color: var(--ink); }

  .billing-yearly { display: none; }
  .plans-grid[data-billing="yearly"] .billing-monthly { display: none; }
  .plans-grid[data-billing="yearly"] .billing-yearly { display: inline; }
  .plans-grid[data-billing="yearly"] p.plan-yearly-note.billing-yearly { display: block; }
</style>

<script>
  const grids = document.querySelectorAll<HTMLElement>('.plans-grid');
  const toggleBtns = document.querySelectorAll<HTMLButtonElement>('[data-billing-toggle]');

  function switchBilling(period: 'monthly' | 'yearly') {
    for (const btn of toggleBtns) {
      const isActive = btn.dataset.billingToggle === period;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-pressed', String(isActive));
    }
    for (const grid of grids) {
      grid.dataset.billing = period;
    }
  }

  for (const btn of toggleBtns) {
    btn.addEventListener('click', () => {
      switchBilling((btn.dataset.billingToggle ?? 'monthly') as 'monthly' | 'yearly');
    });
  }
</script>
