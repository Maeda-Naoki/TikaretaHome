---
import Ic from '@components/common/Ic.astro';
import { plans } from '@data/pricing';
---
<section id="pricing" class="section-pad" style="background:var(--surface-2);">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">Pricing</span>
      <h2>シンプルな料金体系。</h2>
      <p>まずは無料で。深く知りたくなったらいつでもアップグレードできます。</p>
    </div>

    <div style="text-align:center;">
      <div class="billing-toggle" id="billing-toggle">
        <button class="active" data-period="monthly" type="button">月払い</button>
        <button type="button" data-period="yearly" style="position:relative;">
          年払い
          <span class="save-tag">4ヶ月お得</span>
        </button>
      </div>
    </div>

    <div class="plans-grid">
      {plans.map((plan) => (
        <div class={`plan plan-${plan.key} reveal ${plan.featured ? 'featured' : ''}`}>
          {plan.featured && <span class="badge">おすすめ</span>}
          <div>
            <p class="plan-name">{plan.name}</p>
            <p class="plan-tagline">{plan.tagline}</p>
          </div>
          <div class="plan-price">
            {plan.monthly === 0 ? (
              <>
                <span class="amount">0</span>
                <span class="currency">円</span>
              </>
            ) : (
              <>
                <span class="currency">¥</span>
                <span class="amount" data-monthly={plan.monthly} data-yearly={Math.round(plan.yearly / 12)}>
                  {plan.monthly}
                </span>
                <span class="period">/月</span>
              </>
            )}
          </div>
          {plan.yearly > 0 && (
            <p class="plan-yearly-note" data-yearly-note={`年払い: ¥${plan.yearly}/年`}></p>
          )}
          <ul>
            {plan.features.map((f) => (
              <li class={!f.on ? 'muted' : ''}>
                <Ic name={f.on ? 'check' : 'minus'} size={14} />
                <span style={f.emphasized ? 'font-weight:600; color:var(--ink);' : ''}>{f.text}</span>
              </li>
            ))}
          </ul>
          <a class={`btn ${plan.ctaStyle}`} href="https://tikareta.com" target="_blank" rel="noopener">
            {plan.ctaLabel}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .plans-grid {
    display: grid; grid-template-columns: 1fr; gap: 1.25rem;
    max-width: 1100px; margin: 0 auto; align-items: start;
  }
  @media (min-width: 640px) { .plans-grid { grid-template-columns: repeat(3, 1fr); } }
</style>

<script>
  function initBillingToggle() {
    const toggle = document.getElementById('billing-toggle');
    if (!toggle) return;

    const btns = toggle.querySelectorAll<HTMLButtonElement>('button');
    const amounts = document.querySelectorAll<HTMLElement>('.amount[data-monthly]');
    const notes = document.querySelectorAll<HTMLElement>('[data-yearly-note]');
    let isYearly = false;

    function update() {
      amounts.forEach((el) => {
        el.textContent = isYearly
          ? el.dataset.yearly ?? el.dataset.monthly ?? ''
          : el.dataset.monthly ?? '';
      });
      notes.forEach((el) => {
        el.textContent = isYearly ? (el.dataset.yearlyNote ?? '') : '';
      });
    }

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        isYearly = btn.dataset.period === 'yearly';
        btns.forEach((b) => b.classList.toggle('active', b.dataset.period === (isYearly ? 'yearly' : 'monthly')));
        update();
      });
    });
  }

  initBillingToggle();
</script>
