---
import Ic from '@components/common/Ic.astro';
import PhoneMock from '@components/common/PhoneMock.astro';
---
<section class="hero-bg grain section-pad" id="hero" style="padding-top:5rem; position:relative;">
  <!-- Decorative paw trail -->
  <div class="paws" aria-hidden="true">
    <span class="paw" style="top:18%; left:6%; --rot:-12deg; --d:.1s">🐾</span>
    <span class="paw" style="top:62%; left:10%; --rot:8deg; --d:.6s">🐾</span>
    <span class="paw" style="top:78%; left:48%; --rot:-4deg; --d:1.1s">🐾</span>
    <span class="paw" style="top:30%; right:8%; --rot:14deg; --d:1.6s">🐾</span>
    <span class="paw" style="top:72%; right:14%; --rot:-10deg; --d:2.1s">🐾</span>
  </div>

  <div class="container-page hero-grid">
    <!-- Copy -->
    <div class="hero-copy">
      <span class="badge-new">
        <span class="dot"></span>2026年春リリース予定 / Phase 1 開発中
      </span>
      <h1 class="hero-headline">
        うちの子の<br />
        <span class="accent">おさんぽ<br class="md:hidden" />スタイル</span>、<br />
        知ってる？
      </h1>
      <p class="hero-lead">
        毎日のおさんぽを、ぽちっと記録するだけ。<br class="hide-sm" />
        距離・歩数・気分の変化から、愛犬の<strong>個性と傾向</strong>が、じわじわ見えてきます。
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="#cta">
          <Ic name="footprints" size={18} />無料で始める
        </a>
        <a class="btn btn-ghost btn-lg" href="#how">
          <Ic name="play" size={14} />使い方を見る
        </a>
      </div>
      <ul class="hero-meta">
        <li><Ic name="check" size={14} />クレカ登録不要</li>
        <li><Ic name="check" size={14} />iOS / Android 対応</li>
        <li><Ic name="check" size={14} />家族と共有OK</li>
      </ul>
    </div>

    <!-- Visual -->
    <div class="hero-visual">
      <div class="hero-stack">
        <div class="hp hp-back">
          <PhoneMock variant="result" size="md" tilt={-7} />
        </div>
        <div class="hp hp-front">
          <PhoneMock variant="home" size="lg" />
        </div>

        <div class="float-card" style="top:6%; right:-4%; animation-delay:.2s;">
          <span class="ico">🔥</span>
          <div>
            <p class="lbl">連続記録</p>
            <p class="val">12日連続</p>
          </div>
        </div>
        <div class="float-card" style="top:46%; right:-10%; animation-delay:1.1s;">
          <span class="ico">🌳</span>
          <div>
            <p class="lbl">うちの子は</p>
            <p class="val">日陰ハンター型</p>
          </div>
        </div>
        <div class="float-card" style="bottom:6%; left:-6%; animation-delay:2s;">
          <span class="ico">📍</span>
          <div>
            <p class="lbl">今日のおさんぽ</p>
            <p class="val">1.42 km / 18分</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid; gap: 3rem;
    grid-template-columns: 1fr;
    align-items: center;
    padding-top: 3rem; padding-bottom: 4rem;
  }
  @media (min-width: 980px) {
    .hero-grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }

  .badge-new {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .35rem .9rem .35rem .7rem; border-radius: var(--r-pill);
    background: var(--surface); border: 1px solid var(--line);
    font-size: .78rem; font-weight: 600; color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }
  .badge-new .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--s500);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--s500) 25%, transparent);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse { 50% { opacity: .55; } }

  .hero-lead {
    margin-top: 1.5rem; font-size: 1.05rem; color: var(--ink-soft);
    max-width: 540px; line-height: 1.75; text-wrap: pretty;
  }
  .hero-lead strong { color: var(--ink); font-weight: 700; }
  .hero-cta { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem; }
  .btn-lg { padding: 1rem 1.6rem; font-size: 1rem; }
  .hero-meta {
    list-style: none; padding: 0; margin: 1.6rem 0 0;
    display: flex; gap: 1.4rem; flex-wrap: wrap;
    font-size: .82rem; color: var(--ink-mute);
  }
  .hero-meta li { display: inline-flex; align-items: center; gap: .35rem; }
  .hero-meta .ic { color: var(--s600); }

  .hero-visual { position: relative; min-height: 580px; }
  .hero-stack { position: relative; display: grid; place-items: center; padding: 2rem 0; }
  .hp-back { position: absolute; left: 8%; top: 12%; opacity: .9; }
  .hp-front { position: relative; z-index: 2; animation: floaty 7s ease-in-out infinite; }

  .hide-sm { display: none; }
  @media (min-width: 768px) { .hide-sm { display: inline; } }

  @media (max-width: 980px) {
    .hero-visual { min-height: auto; }
    .hp-back { display: none; }
    .float-card { display: none; }
  }
</style>
