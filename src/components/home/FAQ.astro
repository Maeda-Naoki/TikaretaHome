---
import Ic from '@components/common/Ic.astro';
import { useTranslations } from '@utils/i18n';

const locale = Astro.currentLocale ?? 'ja';
const t = useTranslations(locale);

interface FaqItem {
  categoryLabel: string;
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  { categoryLabel: t.faq.categories.basic, ...t.faq.basic.whatIsOsanpoType },
  { categoryLabel: t.faq.categories.basic, ...t.faq.basic.howToStart },
  { categoryLabel: t.faq.categories.basic, ...t.faq.basic.deviceChange },
  { categoryLabel: t.faq.categories.basic, ...t.faq.basic.batteryUsage },
  { categoryLabel: t.faq.categories.diagnosis, ...t.faq.diagnosis.whenDiagnosis },
  { categoryLabel: t.faq.categories.diagnosis, ...t.faq.diagnosis.typeChange },
  { categoryLabel: t.faq.categories.pricing, ...t.faq.pricing.freeFeatures },
  { categoryLabel: t.faq.categories.pricing, ...t.faq.pricing.dataAfterDowngrade },
  { categoryLabel: t.faq.categories.pricing, ...t.faq.pricing.cancelAnytime },
  { categoryLabel: t.faq.categories.privacy, ...t.faq.privacy.locationPrivacy },
  { categoryLabel: t.faq.categories.privacy, ...t.faq.privacy.accountDeletion },
  { categoryLabel: t.faq.categories.privacy, ...t.faq.privacy.dataHandling },
];
---
<section id="faq" class="section-pad" style="background:var(--bg);">
  <div class="container-page">
    <div class="section-head reveal">
      <span class="eyebrow">FAQ</span>
      <h2>{t.faq.title}</h2>
    </div>

    <div class="faq-list">
      {faqs.map((item, i) => (
        <details class="faq-item reveal" style={`transition-delay:${i * 40}ms;`}>
          <summary>
            <span>
              <span class="faq-cat-tag">{item.categoryLabel}</span>
              {item.question}
            </span>
            <Ic name="plus" size={18} />
          </summary>
          <div class="answer">{item.answer}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list { display: flex; flex-direction: column; gap: .65rem; max-width: 760px; margin: 0 auto; }
</style>
