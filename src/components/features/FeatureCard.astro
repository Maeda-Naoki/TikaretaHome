---
import Icon from '@components/common/Icon.astro';

interface Props {
  icon: string;
  iconType: 'lucide' | 'emoji';
  title: string;
  description: string;
}

const { icon, iconType, title, description } = Astro.props;
---

<div class="p-6 bg-white rounded-card border border-warm-gray-100 hover:shadow-card transition-all scale-in">
  <div class="mb-3 w-11 h-11 bg-primary-50 rounded-soft flex items-center justify-center">
    <Icon name={icon} type={iconType} size={24} class="text-primary-600" />
  </div>
  <h3 class="text-lg font-bold text-warm-gray-900 mb-2">{title}</h3>
  <p class="text-sm text-warm-gray-600">{description}</p>
</div>
