{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "ignorePatterns": [
    "node_modules",
    ".pnpm-store",
    "dist",
    ".astro",
    "coverage",
    "*.min.js",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "pnpm-lock.yaml"
  ]
}
